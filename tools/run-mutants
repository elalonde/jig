#!/usr/bin/env python3
"""Prove each tool's test can fail: apply its seeded break and watch the test go red.

usage: run-mutants [--root <product>] <mutants-dir> [<tool> ...]

<mutants-dir>/tools.txt names the tools, one per line. A tool has one patch,
<tool>.patch, and one test module, tests/test_<tool>.py with '-' read as '_'.
Each run uses a scratch copy, so the working tree stays as it was. Exit 0 only
when every named tool's test is green unbroken and red with its patch.
"""

import argparse
import pathlib
import shutil
import subprocess
import sys
import tempfile

TEST_TIMEOUT_SECONDS = 300


class Failed(Exception):
    """A tool's seeded break does not prove what it has to prove."""


def read_tools(mutants):
    listing = mutants / "tools.txt"
    try:
        lines = listing.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise Failed(f"cannot read {listing}: {error}") from None
    tools = [line.split("#", 1)[0].strip() for line in lines]
    tools = [tool for tool in tools if tool]
    if not tools:
        raise Failed(f"{listing} names no tool")
    return tools


def run_test(copy, module):
    """Return the test's exit code, or raise when it does not finish."""
    try:
        return subprocess.run(
            [sys.executable, "-m", "unittest", module], cwd=copy, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=TEST_TIMEOUT_SECONDS, check=False,
        ).returncode
    except subprocess.TimeoutExpired:
        raise Failed(f"{module} did not finish in {TEST_TIMEOUT_SECONDS} s") from None


def check_tool(root, mutants, tool):
    patch = (mutants / f"{tool}.patch").resolve()
    if not patch.is_file():
        raise Failed(f"{tool}: no patch at {patch}")
    module = "tests.test_" + tool.replace("-", "_")

    with tempfile.TemporaryDirectory(prefix="run-mutants.") as scratch:
        copy = pathlib.Path(scratch) / "tree"
        shutil.copytree(root, copy, symlinks=True,
                        ignore=shutil.ignore_patterns(".git", "__pycache__"))

        # A red test before the patch would make any patch look like it worked.
        if run_test(copy, module) != 0:
            raise Failed(f"{tool}: {module} fails without the patch, or does not exist")

        # git apply skips paths it thinks are outside its repository, so give it one.
        subprocess.run(["git", "init", "-q"], cwd=copy, check=True)
        applied = subprocess.run(["git", "apply", str(patch)], cwd=copy, check=False,
                                 capture_output=True, text=True)
        if applied.returncode != 0:
            raise Failed(f"{tool}: patch does not apply: {applied.stderr.strip()}")

        if run_test(copy, module) == 0:
            raise Failed(f"{tool}: patch applied and {module} still passes")


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("--root", type=pathlib.Path,
                        default=pathlib.Path(__file__).resolve().parent.parent)
    parser.add_argument("mutants", type=pathlib.Path)
    parser.add_argument("tools", nargs="*")
    args = parser.parse_args(argv)

    failures = []
    try:
        listed = read_tools(args.mutants)
    except Failed as error:
        print(f"run-mutants: {error}", file=sys.stderr)
        return 1

    for tool in args.tools:
        if tool not in listed:
            failures.append(f"{tool}: not in tools.txt")
    if not args.tools:
        # A patch no tool names would never run, and would rot unseen.
        for patch in sorted(args.mutants.glob("*.patch")):
            if patch.stem not in listed:
                failures.append(f"{patch.name}: no tool in tools.txt names it")

    for tool in args.tools or listed:
        if tool not in listed:
            continue
        try:
            check_tool(args.root, args.mutants, tool)
            print(f"run-mutants: {tool}: the patch makes its test fail")
        except Failed as error:
            failures.append(str(error))

    for failure in failures:
        print(f"run-mutants: {failure}", file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
