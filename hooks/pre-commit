#!/usr/bin/env python3
# jig pre-commit hook
# jig start and jig new find their own file by the exact line above.
"""Refuse a commit to the product that adds a private term of the project.

The term check looks for the project's private terms, the lines of terms.txt, in
the product. It is the row "terms" of checks.tsv at the root of the project's -dev
clone: name, command, account, time cap in seconds, and an optional weight, heavy or
light, separated by tabs. The -dev clone of a product clone named demo is demo-dev
beside it, and no other place counts. A linked work tree of the product clone (git
worktree add), in any folder, has the -dev clone of the main work tree of its
repository: the folder that holds the .git directory that git rev-parse
--git-common-dir names. When that directory is not named .git, the repository has
no main work tree, and the commit is refused. So is a commit with no -dev clone or
no such row.

This one file is two hooks, told apart by its second line. jig start and jig new
install it as the pre-commit hook, and as the commit-msg hook with the second line
"# jig commit-msg hook" in place of the one above.

When the row's command is "jig terms check <project>" and the jig that the
dispatcher runs for the project is 0.8.2 or newer, the hooks check only what the
commit adds, so that a match already in the product does not stop every commit: the
pre-commit hook adds --staged and the root of the work tree, and the commit-msg hook
adds --message and the message file that git gives it. That version is the name of
the installed tree that "jig which <project>" prints from the -dev clone, after
symbolic links are followed. When jig which fails or the name is not a version, the
version counts as older, because an older jig has neither option: the pre-commit
hook then runs the row's command as it is, the check of the whole product, and the
commit-msg hook checks nothing. With any other command in the row, the pre-commit
hook runs that command as it is and the commit-msg hook checks nothing.

A command runs with sh -c from the root of the -dev clone, and the commit is refused
when it does not exit 0 or runs past its cap. The check names the place of each
match and never the term, so its output is safe to show here.

When the row is heavy and the host config sets HEAVY_SLOTS, the hook first takes a
heavy slot of the host, as jig run-check does, and waits while every slot is held;
the cap counts from the start of the command, after the wait. On SIGTERM, SIGHUP or
SIGINT while the command runs, it kills the command's group before it exits, so that
the slot is free only once the command is gone.

jig start and jig new replace or remove a hook only when its second line is one of
the two marker lines, so a project's own hook is never lost.

The hook is a single file with no import from jig's tree, because jig start
copies it into clones of accounts that cannot read that tree. So dev_clone below
writes again the rule of lib/jig_clones.py, and tests/test_clones.py runs the same
layouts on both. In the same way parse_row and the slot code write again those of
lib/jig_checks.py, which explains the slots, and tests/test_jig_checks.py runs the
same rows on both parses.
"""

import datetime
import fcntl
import os
import pathlib
import pwd
import re
import shlex
import signal
import subprocess
import sys
import time

ROW = "terms"
# The second line of this file as each of the two hooks.
PRE_COMMIT_MARKER = "# jig pre-commit hook"
COMMIT_MSG_MARKER = "# jig commit-msg hook"
# The command of the row that jig's own term check has, with the project's name.
TERMS_COMMAND = re.compile(r"jig terms check ([a-z0-9][a-z0-9._-]*)")
# The first jig whose term check has the options --staged and --message.
FIRST_ADDED_ONLY = (0, 8, 2)
# The name of an installed tree: numbers with a dot between each two.
VERSION = re.compile(r"[0-9]+(?:\.[0-9]+)+")
WHICH_SECONDS = 30
# The name of the git directory inside a main work tree.
GIT_DIR_NAME = ".git"
HEAVY = "heavy"
LIGHT = "light"
SHAPE = ("is not name, command, account, cap in seconds, and an optional weight, "
         "heavy or light")
WHOLE_NUMBER = re.compile(r"[0-9]+")
SLOTS_KEY = "HEAVY_SLOTS"
HELD = "JIG_HEAVY_SLOT"
DENIED_POLLS = 3
HOLDER_FIELDS = 6
STOP_SIGNALS = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)
# A unit's tmux session is <project>-<role>-<ID>, as jig run-check reads it.
SESSION_NAME = re.compile(r".+-(?:spec|impl|rev)-(?P<id>[a-z0-9]{1,6})")


class BadRow(Exception):
    """A row of checks.tsv is malformed; the message says how, after the row's name."""


class SlotError(Exception):
    """A heavy slot cannot be taken; the message names the file or the key."""


class NoRoot(Exception):
    """git cannot name the root of the work tree of the commit."""


class Stopped(Exception):
    """A signal asked the hook to stop; it carries the signal number."""


def on_signal(signum, _frame):
    raise Stopped(signum)


def git(*args, env=None):
    return subprocess.run(["git", *args], capture_output=True, text=True, env=env,
                          stdin=subprocess.DEVNULL, check=False)


def hook_name():
    """Return "pre-commit" or "commit-msg", by the second line of this file."""
    try:
        with open(os.path.realpath(__file__), encoding="utf-8", errors="replace") as stream:
            stream.readline()
            second = stream.readline().rstrip("\r\n")
    except OSError:
        second = ""
    return "commit-msg" if second == COMMIT_MSG_MARKER else "pre-commit"


NAME = hook_name()


def refuse(reason):
    print(f"jig {NAME} hook: {reason}; the commit is refused", file=sys.stderr)
    return 1


def environment_without_git():
    """Return this environment without the variables that git sets for its hooks.

    Left in place, they would point every git command of the check at the product's
    repository and index, also a command that means to read the -dev clone.
    """
    listed = set(git("rev-parse", "--local-env-vars").stdout.split())
    return {key: value for key, value in os.environ.items() if key not in listed}


def dev_clone():
    """Return the -dev clone of this repository, or None and the line that says why not.

    It is the -dev clone of the main work tree, so a linked work tree in any folder
    finds the same one as the clone itself.
    """
    named = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if named.returncode != 0 or not named.stdout.strip():
        return None, "git cannot name the git directory of this clone"
    common = os.path.realpath(named.stdout.strip())
    if os.path.basename(common) != GIT_DIR_NAME:
        return None, (f"the git directory {common} is not named {GIT_DIR_NAME}, so the "
                      "repository has no main work tree and no -dev clone")
    main = os.path.dirname(common)
    parent, name = os.path.split(main)
    beside = os.path.join(parent, name + "-dev")
    if not os.path.isdir(beside):
        return None, (f"no -dev clone beside {main}: {beside} is not a directory, so "
                      "there is no checks.tsv to read")
    return beside, None


def jig_version(project, dev, env):
    """Return the version of the jig that the dispatcher runs for the project, or None.

    It is the name of the tree that jig which prints, with symbolic links followed, as
    a tuple of numbers. None means that it cannot be read.
    """
    try:
        shown = subprocess.run(["jig", "which", project], cwd=dev, env=env,
                               capture_output=True, text=True, stdin=subprocess.DEVNULL,
                               timeout=WHICH_SECONDS, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    tree = shown.stdout.strip()
    if shown.returncode != 0 or not tree or "\n" in tree:
        return None
    name = os.path.basename(os.path.realpath(os.path.join(dev, tree)))
    if not VERSION.fullmatch(name):
        return None
    return tuple(int(part) for part in name.split("."))


def checks_added_only(command, dev, env):
    """Say whether the row's command is jig's term check, run by a jig that has the
    options for only what a commit adds."""
    found = TERMS_COMMAND.fullmatch(command.strip())
    if not found:
        return False
    version = jig_version(found.group(1), dev, env)
    return version is not None and version >= FIRST_ADDED_ONLY


def parse_row(line):
    """Return name, command, account, cap and weight of one row, or raise BadRow."""
    fields = line.split("\t")
    if len(fields) not in (4, 5) or not WHOLE_NUMBER.fullmatch(fields[3]) \
            or int(fields[3]) == 0:
        raise BadRow(SHAPE)
    weight = fields[4] if len(fields) == 5 else ""
    if weight not in ("", HEAVY, LIGHT):
        raise BadRow(f"has the weight {weight!r}; the weight is heavy or light, "
                     f"or empty for light")
    return fields[0], fields[1], fields[2], int(fields[3]), weight or LIGHT


def read_row(dev):
    """Return the command, cap and weight of the row, or None and why it is unusable."""
    path = os.path.join(dev, "checks.tsv")
    try:
        with open(path, encoding="utf-8") as stream:
            lines = stream.read().splitlines()
    except (OSError, UnicodeDecodeError) as error:
        return None, f"cannot read {path}: {getattr(error, 'strerror', None) or error}"
    # The first line names the columns.
    for line in lines[1:]:
        if line.split("\t")[0] != ROW:
            continue
        try:
            _, command, _, cap, weight = parse_row(line)
        except BadRow as problem:
            return None, f"the row {ROW} of {path} {problem}"
        return (command, cap, weight), None
    return None, f"{path} has no row {ROW}, so the term check cannot run"


def heavy_slots():
    """Return HEAVY_SLOTS of host.conf, or None for no limit, as jig_checks reads it."""
    path = pathlib.Path(os.environ.get("JIG_SRV") or "/srv/jig") / "host.conf"
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError) as error:
        raise SlotError(f"cannot read {path}: {getattr(error, 'strerror', None) or error}") \
            from None
    value = None
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, found = line.split("=", 1)
            if key.strip() == SLOTS_KEY:
                value = found.strip()
    if value is None:
        return None
    if not WHOLE_NUMBER.fullmatch(value) or int(value) == 0:
        raise SlotError(f"{path}: {SLOTS_KEY}={value!r} is not a whole number of 1 or more")
    return int(value)


def poll_seconds():
    text = os.environ.get("JIG_HEAVY_POLL")
    if not text:
        return 5.0
    try:
        seconds = float(text)
    except ValueError:
        seconds = 0
    if not seconds > 0:
        raise SlotError(f"JIG_HEAVY_POLL={text!r} is not a number of seconds above 0")
    return seconds


def make_dir(path):
    """Make the slot directory when it is missing; set its mode only when made here."""
    try:
        os.mkdir(path, 0o2775)
    except FileExistsError:
        return
    except OSError as error:
        raise SlotError(f"cannot make {path}: {error.strerror}") from None
    try:
        os.chmod(path, 0o2775)
    except OSError as error:
        raise SlotError(f"cannot set the mode of {path}: {error.strerror}") from None


def owner(path):
    try:
        uid = os.stat(path).st_uid
    except OSError:
        return "?"
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def try_slot(path):
    """Return a descriptor that holds the slot's lock, or None when it is held."""
    # No O_TRUNC: a waiter that opens a held slot must not erase its holder's line.
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o664)
    try:
        if os.fstat(descriptor).st_uid == os.getuid():
            # The other accounts of the host share the file; only the owner may chmod.
            os.fchmod(descriptor, 0o664)
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        return None
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor


def unit_name(env):
    """Return the unit ID from the tmux session name, the whole name, or "-" outside tmux."""
    if not env.get("TMUX"):
        return "-"
    shown = subprocess.run(["tmux", "display-message", "-p", "#S"], capture_output=True,
                           text=True, env=env, stdin=subprocess.DEVNULL, check=False)
    session = shown.stdout.strip()
    if shown.returncode != 0 or not session:
        return "-"
    match = SESSION_NAME.fullmatch(session)
    return match["id"] if match else session


def holder_line(dev, env):
    """Return who holds the slot: project, unit, row, account, start time and pid."""
    name = os.path.basename(os.path.realpath(dev))
    project = name[:-len("-dev")] if name.endswith("-dev") else name
    fields = (project, unit_name(env), ROW, pwd.getpwuid(os.getuid()).pw_name,
              datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
              str(os.getpid()))
    return "\t".join(field or "-" for field in fields) + "\n"


def describe(path):
    """Return project, unit and row of the slot's holder from its text, or "?"."""
    try:
        with open(path, encoding="utf-8") as stream:
            fields = stream.readline().rstrip("\n").split("\t")
    except (OSError, UnicodeDecodeError):
        return "?"
    if len(fields) != HOLDER_FIELDS or not all(fields[:3]):
        return "?"
    return f"project {fields[0]}, unit {fields[1]}, row {fields[2]}"


def say(text):
    print(f"jig {NAME} hook: {text}", file=sys.stderr, flush=True)


def take_slot(dev, env):
    """Return the number of a free heavy slot, held, waiting while every slot is held.

    Return None when there is no limit or this process tree already holds a slot. The
    lock lasts until the hook exits.
    """
    if env.get(HELD):
        return None
    count = heavy_slots()
    if count is None:
        return None
    poll = poll_seconds()
    directory = pathlib.Path(env.get("JIG_HEAVY_DIR") or "/run/jig/heavy")
    make_dir(directory)
    line = holder_line(dev, env)
    denied = {}
    started = time.monotonic()
    waited = False
    while True:
        for number in range(1, count + 1):
            path = directory / str(number)
            try:
                descriptor = try_slot(path)
            except PermissionError:
                denied[number] = denied.get(number, 0) + 1
                if denied[number] > DENIED_POLLS:
                    raise SlotError(f"cannot open {path}, a file of {owner(path)}, after "
                                    f"{DENIED_POLLS} more tries") from None
                continue
            except OSError as error:
                raise SlotError(f"cannot take {path}: {error.strerror}") from None
            if descriptor is None:
                denied.pop(number, None)
                continue
            os.ftruncate(descriptor, 0)
            os.write(descriptor, line.encode("utf-8"))
            if waited:
                say(f"took heavy slot {number} after {round(time.monotonic() - started)} s")
            return number
        if not waited:
            held = "; ".join(f"slot {number}: {describe(directory / str(number))}"
                             for number in range(1, count + 1))
            say(f"every heavy slot is held, waiting: {held}")
            waited = True
        time.sleep(poll)


def kill_group(process):
    for signum in STOP_SIGNALS:
        signal.signal(signum, signal.SIG_IGN)
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def run_check(command, dev, env, cap):
    """Run the command in its own process group, so that a stop at the cap ends all of it."""
    process = subprocess.Popen(["sh", "-c", command], cwd=dev, env=env,
                               stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        return process.wait(timeout=cap)
    except subprocess.TimeoutExpired:
        kill_group(process)
        return None
    except Stopped:
        kill_group(process)
        raise


def hook_command(command, dev, env):
    """Return the command this hook runs and its environment, or None to check nothing.

    The variables that git sets for a hook are left out, so that every git command of
    the check reads the repository it runs in. The pre-commit hook gives the index of
    the commit back, as an absolute path, to the check of what the commit stages: git
    commit -a and git commit <path> stage in an index of their own.
    """
    added_only = checks_added_only(command, dev, env)
    if NAME == "commit-msg":
        if not added_only or len(sys.argv) < 2:
            return None, env
        return f"{command.strip()} --message {shlex.quote(os.path.abspath(sys.argv[1]))}", env
    if not added_only:
        return command, env
    shown = git("rev-parse", "--show-toplevel")
    top = shown.stdout.strip()
    if shown.returncode != 0 or not top:
        raise NoRoot("cannot find the root of this work tree")
    if os.environ.get("GIT_INDEX_FILE"):
        env = dict(env, GIT_INDEX_FILE=os.path.abspath(os.environ["GIT_INDEX_FILE"]))
    return f"{command.strip()} --staged {shlex.quote(top)}", env


def main():
    env = environment_without_git()
    dev, problem = dev_clone()
    if dev is None:
        return refuse(problem)
    row, problem = read_row(dev)
    if problem:
        return refuse(problem)
    command, cap, weight = row
    try:
        command, env = hook_command(command, dev, env)
    except NoRoot as problem:
        return refuse(str(problem))
    if command is None:
        return 0
    for signum in STOP_SIGNALS:
        signal.signal(signum, on_signal)
    try:
        if weight == HEAVY:
            try:
                slot = take_slot(dev, env)
            except SlotError as error:
                return refuse(str(error))
            if slot is not None:
                env = dict(env, **{HELD: str(slot)})
        code = run_check(command, dev, env, cap)
    except Stopped as stopped:
        refuse(f"stopped by {signal.Signals(stopped.args[0]).name}")
        return 128 + stopped.args[0]
    if code is None:
        return refuse(f"the term check ran past its cap of {cap} s")
    if code != 0:
        return refuse(f"the term check exited {code}; the lines above name each place")
    return 0


if __name__ == "__main__":
    sys.exit(main())
