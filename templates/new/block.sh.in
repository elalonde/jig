# new  as @OWNER@ on @HOST@ — role: owner
# jig new @PROJECT@: the steps that need the owner, in order 1 to 7.
# 1 facts and the gh login; 2 GitHub repos; 3 deploy keys; 4 first
# push of the seed repos; 5 clones in the role accounts; 6 model
# policy rules; 7 jig's status line in each account's Claude Code
# settings, and ~/.tmux.conf. The settings get no hook of another
# tool. gh asks for a login only when it has none, and logs out at
# the end. Safe to run twice: each step keeps what is already there.
# Checked by jig new: the accounts answer by ssh; the deploy keys and
# the seed repos exist; the policy file exists. Not checked: that the
# GitHub names are free; that the status line command exists, which
# jig upgrade installs; that it runs in a new session.
set -eu -o pipefail

P=@PROJECT@
GH=@GITHUB_OWNER@
ORCH=@ORCH@
SPEC=@SPEC@
IMPL=@IMPL@
ORCH_HOME=@ORCH_HOME@
SPEC_HOME=@SPEC_HOME@
IMPL_HOME=@IMPL_HOME@
POLICY=@POLICY@
LINE=@STATUS_LINE@
URL=https://github.com/$GH
G=(git -c credential.helper=
  -c "credential.helper=!gh auth git-credential")
export GIT_SSH_COMMAND="ssh -o BatchMode=yes"
T=$(mktemp -d)
LOGIN=
cleanup() {
  if [ -n "$LOGIN" ]; then
    gh auth logout --hostname github.com </dev/null >/dev/null 2>&1 ||
      true
  fi
  rm -rf "$T"
}
trap cleanup EXIT
die() { echo "new: $*"; exit 1; }
# shellcheck disable=SC2029  # the command expands in the account
on() { ssh -o BatchMode=yes "$1@localhost" "$2" </dev/null; }

echo "step 1: user=$(id -un)"
[ "$(id -un)" = @OWNER@ ] || die "run as @OWNER@"
[ -f ~/.tmux.conf ] || die "no ~/.tmux.conf to copy"
for a in "$ORCH" "$SPEC" "$IMPL"; do
  on "$a" true || die "no ssh to $a"
done
if ! gh auth status --hostname github.com </dev/null >/dev/null 2>&1
then
  LOGIN=yes
  gh auth login --hostname github.com --git-protocol https </dev/tty
fi
echo "step 1 ok"

echo "step 2: GitHub repos, private"
for r in "$P-dev" "$P"; do
  if gh repo view "$GH/$r" </dev/null >/dev/null 2>&1; then
    echo "repo $r kept"
  else
    gh repo create "$GH/$r" --private </dev/null >/dev/null
    echo "repo $r made"
  fi
done

echo "step 3: deploy keys"
key() { # account repo [--allow-write]
  local f pub
  f="${2//-/_}_deploy"
  pub=$(on "$1" "cat ~/.ssh/$f.pub")
  if gh repo deploy-key list -R "$GH/$2" --json key -q '.[].key' \
    </dev/null | grep -qF "$(echo "$pub" | cut -d' ' -f2)"; then
    echo "key $1 $2 kept"
    return 0
  fi
  printf '%s\n' "$pub" > "$T/key.pub"
  gh repo deploy-key add "$T/key.pub" -R "$GH/$2" -t "$1 $f" \
    "${@:3}" </dev/null >/dev/null
  echo "key $1 $2 made"
}
key "$ORCH" "$P-dev" --allow-write
key "$SPEC" "$P-dev" --allow-write
key "$IMPL" "$P-dev" --allow-write
key "$ORCH" "$P"
key "$IMPL" "$P"

echo "step 4: first push of the seed repos"
push() { # repo path-in-orchestrator
  if [ -n "$("${G[@]}" ls-remote --heads "$URL/$1.git" </dev/null)" ]
  then
    echo "push $1 kept"
    return 0
  fi
  # A bare clone has every branch as its own head, so --all pushes
  # them all; a working clone would hold 0.1 only as origin/0.1.
  git clone -q --bare "$ORCH@localhost:$2" "$T/$1" </dev/null
  "${G[@]}" -C "$T/$1" push -q --all "$URL/$1.git" </dev/null
  echo "push $1 made"
}
push "$P-dev" "ws/src/$P-dev"
push "$P" "ws/src/$P"

echo "step 5: clones"
# The two clones of an account are siblings: ~/ws/src/$P-dev and
# ~/ws/src/$P, never one inside the other.
up="git fetch -q origin && git branch -q -u origin/master master"
up="$up && git branch -q -u origin/0.1 0.1"
on "$ORCH" "cd ~/ws/src/$P-dev && $up && cd ../$P && $up"
d=ws/src/$P-dev
p=ws/src/$P
c="git clone -q -b 0.1"
on "$SPEC" "[ -d ~/$d ] || $c github-$P-dev:$GH/$P-dev ~/$d"
on "$IMPL" "[ -d ~/$d ] || $c github-$P-dev:$GH/$P-dev ~/$d"
on "$IMPL" "[ -d ~/$p ] || $c github-$P:$GH/$P ~/$p"
# A product that tracks its hooks directory gets git to read it in every
# product clone, as in the seed clone. Otherwise jig start puts the
# pre-commit hook in .git/hooks, and once the product's make check sets
# the hooks path, git skips that hook for the rest of the first unit.
# Setting the same value again is harmless, so the step can run twice.
hp="[ ! -d ~/$p/hooks ] || git -C ~/$p config core.hooksPath hooks"
on "$ORCH" "$hp"
on "$IMPL" "$hp"
echo "step 5 ok"

echo "step 6: model policy rules"
[ -e "$POLICY.new-$P.bak" ] || cp -p "$POLICY" "$POLICY.new-$P.bak"
rule() { # account home role expect
  local cwd="$2/ws/src/$P-dev"
  if grep -qF "cwd = \"$cwd\"" "$POLICY"; then
    echo "rule $1 kept"
    return 0
  fi
  printf '\n[[rule]]\nuser = "%s"\ncwd = "%s"\n' "$1" "$cwd" \
    >> "$POLICY"
  printf 'role = "%s"\nexpect = %s\n' "$3" "$4" >> "$POLICY"
  echo "rule $1 made"
}
rule "$ORCH" "$ORCH_HOME" orchestrator '["Opus"]'
rule "$SPEC" "$SPEC_HOME" "spec writer" '["Opus", "Fable", "Sonnet"]'
rule "$IMPL" "$IMPL_HOME" implementer '["Opus", "Fable", "Sonnet"]'
if ! python3 -I -c 'import sys, tomllib
tomllib.load(open(sys.argv[1], "rb"))' "$POLICY"; then
  cp -p "$POLICY.new-$P.bak" "$POLICY"
  die "the policy is not valid; restored"
fi

echo "step 7: status line, ~/.tmux.conf"
want=$(sha256sum < ~/.tmux.conf | cut -c1-8)
for a in "$ORCH" "$SPEC" "$IMPL"; do
  # Only the statusLine entry is written, so the settings get no hook.
  # A status line of another command is replaced; the file as it was
  # before the first change stays in settings.json.bak-new.
  ssh -o BatchMode=yes "$a@localhost" python3 -I - "$LINE" <<'PY'
import json, os, shutil, sys
line = sys.argv[1]
f = os.path.expanduser("~/.claude/settings.json")
try:
    with open(f, encoding="utf-8") as h:
        d = json.load(h)
except FileNotFoundError:
    d = {}
old = d.get("statusLine")
if isinstance(old, dict) and old.get("command") == line:
    print("settings kept")
    sys.exit(0)
if os.path.exists(f) and not os.path.exists(f + ".bak-new"):
    shutil.copyfile(f, f + ".bak-new")
    os.chmod(f + ".bak-new", 0o600)
d["statusLine"] = {"type": "command", "command": line,
                   "refreshInterval": 60}
os.makedirs(os.path.dirname(f), exist_ok=True)
with open(f + ".tmp", "w", encoding="utf-8") as h:
    json.dump(d, h, indent=2)
    h.write("\n")
os.chmod(f + ".tmp", 0o600)
os.replace(f + ".tmp", f)
print("settings made")
PY
  have=$(on "$a" "sha256sum < ~/.tmux.conf | cut -c1-8" 2>/dev/null ||
    true)
  if [ "$have" = "$want" ]; then
    echo "tmux $a kept"
    continue
  fi
  ssh -o BatchMode=yes "$a@localhost" \
    'cat > ~/.tmux.conf.new && mv ~/.tmux.conf.new ~/.tmux.conf' \
    < ~/.tmux.conf
  on "$a" "tmux source-file ~/.tmux.conf 2>/dev/null || true"
  echo "tmux $a made"
done

# Readback. Expected: steps 1 to 7 in order; "made" lines on the first
# run and "kept" lines on a second run; then one line per account:
# the account, the word statusLine, and the command of LINE above; one
# head per account, the same hash three times; rules=3; tmux equal to
# want for each account.
echo "--- readback new"
for a in "$ORCH" "$SPEC" "$IMPL"; do
  c=$(ssh -o BatchMode=yes "$a@localhost" python3 -I - <<'PY'
import json, os
f = os.path.expanduser("~/.claude/settings.json")
try:
    with open(f, encoding="utf-8") as h:
        print(json.load(h)["statusLine"]["command"])
except (OSError, ValueError, KeyError, TypeError):
    print("none")
PY
)
  echo "$a statusLine $c"
done
for a in "$ORCH" "$SPEC" "$IMPL"; do
  echo "$a head $(on "$a" "git -C ~/$d log -1 --format=%h")"
done
echo "rules=$(grep -cF "/ws/src/$P-dev\"" "$POLICY")"
for a in "$ORCH" "$SPEC" "$IMPL"; do
  echo "$a tmux $(on "$a" "sha256sum < ~/.tmux.conf | cut -c1-8")"
done
echo "want $want"
echo "new done"
# end new
