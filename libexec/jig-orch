FOLLOW_SECONDS = 0.2
# The orchestrator's log of its updates in its clone, where the loop also writes idle
# lines; a commit that changes only this file is no change for the hourly tick.
UPDATES_LOG = "impl/orch/updates.log"
STATUS_LOG = "impl/log/status.log"
# A fetch that hangs on the network is ended after this, so that the next poll tries again.
FETCH_CAP_SECONDS = 30.0
# A line of orch/announced: inode, modification time in nanoseconds, path.
RECORD_LINE = re.compile(r"(\d+) (\d+) (.+)")


class FileMark:
    """The inbox file or readback that a queued line names, as it was when queued.

    It is a class of its own, not a tuple, because the queue tells a reminder by its
    tuple mark.
    """

    __slots__ = ("path", "inode", "mtime")

    def __init__(self, path, inode, mtime):
        self.path, self.inode, self.mtime = path, inode, mtime


class QuietMark:
    """The mark of a stall or resumed line: it goes into no record, and it is no change
    for the hourly tick, because the turn that it starts already tells the news."""

    __slots__ = ()


QUIET = QuietMark()

# The activity file and the waits file, under orch/. Each holds lines of tab-separated
# fields, and each is written whole into a temporary file that a rename puts in place.
ACTIVITY_FILE = "activity"
WAITS_FILE = "waits"
# The orchestrator writes this file when it waits on purpose; the loop reads only when
# it was last modified.
WAITING_FILE = "waiting"
ACTIVITY_SECONDS = 60.0
# The activity states, in the order the loop tests them.
STATES = ("unit", "down", "idle", "busy")
# An activity file older than this many activity polls has no loop that writes it.
STALE_POLLS = 3
# A unit's lock older than this many times its expected minutes is the lock of a unit
# that died: jig wait gives up on a unit at the same age.
LOCK_FACTOR = 3
# The host config key of the stall time, its default, and the busy polls that end a stall.
STALL_KEY = "ORCH_STALL_MINUTES"
STALL_MINUTES = 15
RESUME_POLLS = 3
# A problem that would repeat at every activity poll goes to the log once in this time.
PROBLEM_SECONDS = 3600.0

# A session that exits this often within the window stops the loop.
QUICK_EXITS = 3
QUICK_WINDOW_SECONDS = 600
START_WAIT_SECONDS = 5.0
# Long enough for a fork that Claude Code starts while the old session exits to show up.
FORK_WINDOW_SECONDS = 60.0
# How long jig orch stop waits for the loop's lock, beyond the fork window that the
# stopping loop spends on its last look for forks.
STOP_WAIT_SECONDS = 30.0
# Claude Code gets this long after SIGTERM before SIGKILL; it is shorter than the wait of
# jig orch stop for the loop's lock, so a loop that ends its session still frees the lock
# in time.
END_WAIT_SECONDS = 10.0
# One line about the session's only pane, its fields split by tabs; the start command,
# last, can hold blanks.
PANE_FORMAT = ("#{session_id}\t#{pane_dead}\t#{pane_pid}\t#{pane_pipe}\t#{pane_id}\t"
               "#{socket_path}\t#{pane_start_command}")
# The Claude Code session ID in the pane's start command. The command is nested in
# bash -lc, and in sg for a member of the session group, so it is found by its pattern
# and not by splitting the command into words.
CLAUDE_ID = re.compile(r"--session-id\s+([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})")


class Pane:
    """The pane of the orchestrator's tmux session, as tmux shows it at one moment."""

    __slots__ = ("session_id", "dead", "pid", "piped", "pane_id", "socket", "command")

    def __init__(self, line):
        session_id, dead, pid, piped, self.pane_id, self.socket, self.command = \
            line.split("\t", 6)
        self.session_id, self.dead, self.pid = session_id, dead == "1", int(pid)
        self.piped = piped == "1"

    def claude_session(self):
        found = CLAUDE_ID.search(self.command)
        return found.group(1) if found else None

    def state(self):
        return "dead" if self.dead else "live"


def setting(name, default):
    text = os.environ.get(name)
    if not text:
        return default
    try:
        value = float(text)
    except ValueError:
        value = 0.0
    if value <= 0:
        raise jig_units.Refused(f"refused: setting: {name} must be a positive number of "
                                f"seconds, not {text}")
    return value


def now_text():
    return datetime.datetime.now().astimezone().replace(microsecond=0).isoformat()


def waited_for(status_text):
    """Say what the project waits for, from the text of impl/log/status.log.

    A line there reads "<time> <ID> start|end <status> <commit>". When the newest line
    starts a unit, nothing has ended that unit since, and the project waits for it;
    after an end line, or with no log, the next step is the orchestrator's.
    """
    lines = [line for line in (status_text or "").splitlines() if line.strip()]
    if lines:
        words = lines[-1].split()
        if len(words) >= 4 and words[2] == "start" and jig_ids.is_unit_id(words[1]):
            return f"unit {words[1]}"
    return "the orchestrator"


# The date to act on an item of the Open part of state.md.
ACT_BY = re.compile(r"\bact by (\d{4}-\d\d-\d\d)\b", re.IGNORECASE)
OPEN_HEADING = "## Open"
LIST_ITEM = re.compile(r"[-*] ")


def open_items(text):
    """Return each list item under the heading Open of state.md, its lines joined.

    An item starts with "- " or "* " at the start of a line and goes on over the
    indented lines after it; a blank line, a line of another form or the next heading
    ends it.
    """
    items, inside, current = [], False, None
    for line in text.splitlines():
        if line.startswith("## "):
            inside, current = line.strip() == OPEN_HEADING, None
        elif not inside:
            continue
        elif LIST_ITEM.match(line):
            current = [line[2:]]
            items.append(current)
        elif current is not None and line.strip() and line[0].isspace():
            current.append(line)
        else:
            current = None
    return [" ".join(" ".join(parts).split()) for parts in items]


def due_items(text, today):
    """Return (item, date) for each Open item of state.md whose act-by date has come."""
    due = []
    for item in open_items(text):
        dates = ACT_BY.findall(item)
        if not dates:
            continue
        try:
            date = datetime.date.fromisoformat(dates[-1])
        except ValueError:
            # A date that does not exist, such as a 31 April, is no date to act on.
            continue
        if date <= today:
            due.append((item, dates[-1]))
    return due


def resumes(arguments, session_id):
    """Say whether a command line continues the Claude Code session with this ID.

    Claude Code takes the session to continue after --resume, as its ID or as the path
    of its transcript, <ID>.jsonl.
    """
    return any(argument == "--resume"
               and (following == session_id or following.endswith(f"/{session_id}.jsonl"))
               for argument, following in zip(arguments, arguments[1:]))


def own_processes():
    """Yield (pid, arguments) for each process of this account, as /proc shows it now.

    A process that ends while it is read is left out.
    """
    uid = os.getuid()
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        try:
            if os.stat(f"/proc/{name}").st_uid != uid:
                continue
            with open(f"/proc/{name}/cmdline", "rb") as stream:
                raw = stream.read()
        except OSError:
            continue
        # The arguments end with a NUL each; a zombie has none.
        yield int(name), [os.fsdecode(part) for part in raw.split(b"\0")[:-1]]


def try_lock(path):
    """Return a descriptor that holds the loop's lock, or None while a loop holds it."""
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        return None
    return descriptor


# The activity file, the waits file and the stall lines. Each loop writes its project's
# state to its activity file; an orchestrator names in its waits file the projects it
# waits on; the loop reads their activity files and appends a stall line when one of
# them has sat idle or down too long. All orchestrators run in one account, so each
# loop can read the orch/ directory of every other project.

def orch_dir(project):
    return pathlib.Path.home() / "ws" / "reviews" / project / "orch"


def account_home(account):
    """Return the home of an account, or None when the account database does not know it.

    The loop runs in the orchestrator account, so its own home answers for that account.
    Asking the account database only for another account keeps a home that HOME sets,
    as a test sets it.
    """
    if account == getpass.getuser():
        return pathlib.Path.home()
    try:
        return pathlib.Path(pwd.getpwnam(account).pw_dir)
    except KeyError:
        return None


def orch_accounts(conf):
    """Return the accounts of the orchestrator role by the conf file of a project.

    They are the words of ORCH_ACCOUNT, or the account orchestrator, the word of the
    role, when the file has no such key, as the approved list of the account takes it.
    The unit state and the home of the activity files both come from here, so that
    the two never use different defaults.
    """
    return (conf.get("ORCH_ACCOUNT") or "").split() or ["orchestrator"]


def orch_home(conf):
    """Return the home of the orchestrator account, or None when it is not known.

    The activity files of all projects are in that home. The stall check, jig orch
    status and wait-on read the activity file of another project there, so that all
    three show the state from the same file.
    """
    return account_home(orch_accounts(conf)[0])


def project_conf(project):
    """Return the conf file of the project as data, or no keys when it cannot be read.

    wait-on runs without a conf file; with none, the orchestrator account is the
    account orchestrator.
    """
    try:
        return jig_units.read_conf(project)
    except jig_units.Refused:
        return {}


def other_orch_dir(home, project):
    """Return the orch directory of a project in the home of the orchestrator account."""
    return home / "ws" / "reviews" / project / "orch"


def stamp(moment):
    return moment.astimezone().replace(microsecond=0).isoformat()


def parse_stamp(text):
    """Return the time of a text in date -Iseconds form, or None; a time without its
    offset is refused, because it cannot be compared with now."""
    try:
        moment = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    return moment if moment.tzinfo else None


def clock(moment, now):
    """The local time of day of a moment, with its date when that is not today."""
    local = moment.astimezone()
    return local.strftime("%H:%M" if local.date() == now.astimezone().date()
                          else "%Y-%m-%d %H:%M")


def write_whole(path, text):
    """Write the file into a temporary file beside it and rename that over the old one,
    so that a reader in another loop sees the old text or the new, never a part."""
    descriptor, name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.chmod(name, 0o644)
        os.replace(name, path)
    except BaseException:
        pathlib.Path(name).unlink(missing_ok=True)
        raise


def parse_activity(text):
    """Return (state, since, written) of an activity file's text, or None when it is
    not one line of a known state and two times."""
    if text.count("\n") != 1 or not text.endswith("\n"):
        return None
    fields = text[:-1].split("\t")
    if len(fields) != 3 or fields[0] not in STATES:
        return None
    since, written = parse_stamp(fields[1]), parse_stamp(fields[2])
    if since is None or written is None:
        return None
    return fields[0], since, written


def read_activity(path):
    """Return (activity, problem): the parsed file and None, or None and "missing" or
    "unparsed"."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None, "missing"
    except (OSError, UnicodeDecodeError):
        return None, "unparsed"
    activity = parse_activity(text)
    return (activity, None) if activity else (None, "unparsed")


def kept_since(old, state, now, poll):
    """Return the since of the state written now: the old since while the state stays
    the same. A loop that starts again keeps the since of the old file only when that
    file is fresh; an older file, as one that a killed loop left, starts a new since."""
    if old is not None and old[0] == state \
            and (now - old[2]).total_seconds() <= STALE_POLLS * poll:
        return old[1]
    return now


def unit_running(conf, project, now):
    """Say whether a project-account lock of the project names a unit that still runs.

    Only the exact lock names of the accounts in the conf file count: a pattern would
    also match the locks of a project whose name starts with this one, and the files of
    expected minutes beside the locks. A lock older than LOCK_FACTOR times its expected
    minutes is taken as the lock of a dead unit, so that an orchestrator that sits idle
    beside it can still stall; without an expected time, or a start time that can be
    read, the lock alone counts.
    """
    names = orch_accounts(conf) + jig_units.accounts(conf)
    for account in dict.fromkeys(names):
        lock = worker.lock_path(project, account)
        if not lock.is_file():
            continue
        start = jig_units._parse_start(jig_units._read_lock(lock).get("start"))
        expected = jig_units.read_expected(lock)
        if start is None or expected is None \
                or (now - start).total_seconds() < LOCK_FACTOR * expected * 60:
            return True
    return False


def activity_state(unit, live, no_bar, screen):
    """Return the activity state, from the facts the loop has at one poll.

    no_bar is the count of polls in a row without the input bar. A dialog is idle even
    with a spinner line above it: nobody answers it, and the stall line then brings the
    orchestrator that waits, which reads the screen.
    """
    if unit:
        return "unit"
    if not live:
        return "down"
    if no_bar >= jig_tmux.DIALOG_POLLS:
        return "idle"
    if screen is not None and jig_tmux.running_turn(screen):
        return "busy"
    return "idle"


def parse_waits(text):
    """Return the lines of a waits file as (other, since text, what), and the count of
    lines that do not parse, which are left out."""
    waits, bad = [], 0
    for line in text.splitlines():
        fields = line.split("\t")
        if len(fields) == 3 and jig_units.PROJECT.fullmatch(fields[0]) \
                and parse_stamp(fields[1]) and fields[2].strip():
            waits.append(tuple(fields))
        elif line.strip():
            bad += 1
    return waits, bad


def describe(found, now, poll):
    """Say in words the activity of a project, from read_activity of its file."""
    activity, problem = found
    if activity is None:
        return "no activity file" if problem == "missing" \
            else "no activity file that can be read"
    state, since, written = activity
    if (now - written).total_seconds() > STALE_POLLS * poll:
        return f"no activity file since {stamp(written)}"
    return f"{state} since {stamp(since)}"


def wait_lines(project, home, now, poll):
    """Return one line for each wait of the project, with the activity of the other.

    home is the home of the orchestrator account, None when it is not known; the
    activity files are then missing.
    """
    try:
        text = (orch_dir(project) / WAITS_FILE).read_text(encoding="utf-8")
    except FileNotFoundError:
        text = ""
    waits, _ = parse_waits(text)
    lines = []
    for other, since, what in waits:
        found = (None, "missing") if home is None \
            else read_activity(other_orch_dir(home, other) / ACTIVITY_FILE)
        shown = describe(found, now, poll)
        lines.append(f"waits on {other}: {shown}; waited on since {since}: {what}")
    return lines


class Watch:
    """One wait as the loop follows it: whether its project stalled, the busy polls in a
    row since then, and the since of each stall already sent."""

    __slots__ = ("stalled", "busy", "sent")

    def __init__(self):
        self.stalled, self.busy, self.sent = False, 0, set()


class Stalls:
    """Which of the projects waited on stalled, and when each stall ended.

    It keeps what it sent in memory only: a loop that starts again can send the stall
    line of the same stall once more.
    """

    def __init__(self, stall_seconds, poll):
        self.stall_seconds, self.poll = stall_seconds, poll
        # A wait is the other project and the since of its line, so that a new wait-on
        # with another text is a new wait, and a cleared wait is forgotten.
        self.watches = {}
        # When the loop first saw an activity file missing or unreadable, by project.
        self.missing = {}

    def state_of(self, other, found, now):
        """Return the state and since of the other project as this loop sees it.

        A missing or unreadable file, or one that its loop has not written for
        STALE_POLLS polls, means that no loop of that project runs: down, since the
        file was last written or since this loop first saw it so.
        """
        activity, problem = found
        if activity is None:
            seen = self.missing.get(other)
            if seen is None or seen[0] != problem:
                seen = self.missing[other] = (problem, now)
            return "down", seen[1]
        self.missing.pop(other, None)
        state, since, written = activity
        if (now - written).total_seconds() > STALE_POLLS * self.poll:
            return "down", written
        return state, since

    def step(self, waits, read, now):
        """Return the stall and resumed lines of one activity poll.

        waits holds the lines of the waits file; read(other) returns read_activity of
        the other project's file. A stall is over only when the other project runs a
        unit, or is busy on RESUME_POLLS polls in a row: a short turn, as one that only
        reads an event, leaves it, so two projects that wait on each other do not wake
        each other in turn.
        """
        lines, current = [], set()
        for other, waited_since, what in waits:
            key = (other, waited_since)
            current.add(key)
            watch = self.watches.setdefault(key, Watch())
            state, since = self.state_of(other, read(other), now)
            if watch.stalled:
                watch.busy = watch.busy + 1 if state == "busy" else 0
                if state == "unit" or watch.busy >= RESUME_POLLS:
                    watch.stalled = False
                    lines.append(f"resumed: {other} {state}")
            elif state in ("idle", "down") and since not in watch.sent \
                    and (now - since).total_seconds() >= self.stall_seconds:
                watch.stalled, watch.busy = True, 0
                watch.sent.add(since)
                lines.append(f"stall: {other} {state} since {clock(since, now)} "
                             f"(waits on: {what})")
        for key in set(self.watches) - current:
            del self.watches[key]
        return lines


def holds_wait(path, last_unit):
    """Say whether the waiting file holds a wait: it was modified after the last end of
    a unit. A missing file, or one whose time cannot be read, holds none, so that the
    orchestrator is woken rather than left idle."""
    try:
        modified = os.stat(path).st_mtime
    except OSError:
        return False
    return modified > last_unit.timestamp()


class Idle:
    """The idle periods of the loop's own project, and the one idle event of each.

    An orchestrator that ends its turn with no unit running and no declared wait would
    sit idle until a person looks, so the loop wakes it once the period has lasted the
    stall time. One event per period at most, so that the turn the event starts cannot
    lead to another event, and an orchestrator is never woken in a loop. It keeps what
    it sent in memory only: a loop that starts again can send the event of the same
    period once more.
    """

    def __init__(self, project, stall_seconds, started):
        self.project, self.stall_seconds = project, stall_seconds
        # The time of the last poll with the state unit, or the start of the loop. A unit
        # ends after its last unit poll, so this is up to one poll early, and a waiting
        # file written after the close of the worker is always later than it.
        self.last_unit = started
        # The start of the open period, or None; the busy polls in a row within it; and
        # whether its event went out.
        self.since, self.busy, self.sent = None, 0, False

    def step(self, state, waiting, now):
        """Return the idle event of one activity poll, or None.

        waiting is the path of the waiting file. The period ends as a stall does: at a
        unit, or at RESUME_POLLS busy polls in a row, so that the short turn that
        reads the event leaves it open.
        """
        if state == "unit":
            self.last_unit, self.since = now, None
            return None
        if state == "busy":
            if self.since is not None:
                self.busy += 1
                if self.busy >= RESUME_POLLS:
                    self.since = None
        else:
            self.busy = 0
            if self.since is None:
                self.since, self.sent = now, False
        if self.since is None or self.sent \
                or (now - self.since).total_seconds() < self.stall_seconds \
                or holds_wait(waiting, self.last_unit):
            return None
        self.sent = True
        return (f"idle: no unit since {clock(self.last_unit, now)}; start the next step, "
                f"or write why you wait in ~/ws/reviews/{self.project}/orch/{WAITING_FILE}")


def waiting_line(path):
    """Return the line of the waiting file as status shows it, or none when it is
    missing."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return "none"
    except (OSError, UnicodeDecodeError) as error:
        return f"{path} cannot be read: {getattr(error, 'strerror', None) or error}"
    lines = text.splitlines()
    return lines[0].strip() if lines and lines[0].strip() else "an empty file"


def stall_time(srv):
    """Return the stall time in seconds from host.conf, and a problem to log or None.

    host.conf holds one KEY=value per line, with spaces allowed around the =, and a line
    that starts with # is a comment, as jig run-check reads it. A missing file or key
    gives the default; a file that cannot be read, or a value that is not a whole
    number of 1 or more, gives the default and a problem, so that the loop still runs.
    """
    path = srv / "host.conf"
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return STALL_MINUTES * 60.0, None
    except (OSError, UnicodeDecodeError) as error:
        return STALL_MINUTES * 60.0, (f"cannot read {path}: "
                                      f"{getattr(error, 'strerror', None) or error}")
    value = None
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, found = line.split("=", 1)
            if key.strip() == STALL_KEY:
                value = found.strip()
    if value is None:
        return STALL_MINUTES * 60.0, None
    if not re.fullmatch(r"[0-9]+", value) or int(value) == 0:
        return STALL_MINUTES * 60.0, (f"{path}: {STALL_KEY}={value!r} is not a whole "
                                      f"number of 1 or more")
    return int(value) * 60.0, None


def parent_of(pid):
    """Return the parent pid of a process, or 0 when it cannot be read."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as stream:
            text = stream.read()
    except OSError:
        return 0
    # The name in brackets can hold blanks and brackets, so the fields after it are
    # counted from the last closing bracket.
    try:
        return int(text.rsplit(")", 1)[1].split()[1])
    except (IndexError, ValueError):
        return 0


def runs_session(pid, session_id):
    """Say whether the process runs with --session-id and this ID among its arguments."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as stream:
            arguments = [os.fsdecode(part) for part in stream.read().split(b"\0")]
    except OSError:
        return False
    return any(argument == "--session-id" and following == session_id
               for argument, following in zip(arguments, arguments[1:]))


# The event file. The loop appends one line to it for each event, and "start <session
# ID>" before each start of a session; the session reads it with jig orch <project> events.

def events_path(project):
    return pathlib.Path.home() / "ws" / "reviews" / project / "orch" / EVENTS_FILE


def start_indexes(lines):
    return [index for index, line in enumerate(lines) if START_LINE.fullmatch(line)]


def current_events(lines):
    """Return the lines after the last start line, the events of the running session;
    with no start line, every line."""
    starts = start_indexes(lines)
    return lines[starts[-1] + 1:] if starts else lines


def old_events(lines):
    """Return the events of the session before the newest one: the lines between the
    last two start lines, or the lines before the only one; with none, no line."""
    starts = start_indexes(lines)
    if not starts:
        return []
    return lines[(starts[-2] + 1 if len(starts) > 1 else 0):starts[-1]]


class Stopped(Exception):
    """The watcher got a signal to end."""


END_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)


def stop_watching(signum, frame):
    raise Stopped


def emit(out, lines):
    # The reader is often a pipe, as under a harness tool that wakes the session for
    # each line it reads; without a flush a line could sit in the buffer for hours.
    for line in lines:
        out.write(line + b"\n")
        out.flush()


def follow(path, out, poll=FOLLOW_SECONDS):
    """Print the current events of the event file, then each line appended to it.

    Return when the process that started the watcher ends, which a change of the parent
    pid shows, so that the watcher of a session that has ended does not run on beside
    the next session's own. A missing file reads as an empty one: the watcher waits for
    it, and each line it gets is new, its start line too. When the file is replaced or
    cut short, the rest of the old one is read first and the new one from its top.
    """
    parent = os.getppid()
    stream, pending, first = None, b"", True
    while os.getppid() == parent:
        if stream is None:
            try:
                stream = open(path, "rb")
            except FileNotFoundError:
                first = False
                time.sleep(poll)
                continue
        data = pending + stream.read()
        lines = data.split(b"\n")
        # A line still being written waits for its newline.
        pending = lines.pop()
        if first:
            lines, first = current_events(lines), False
        emit(out, lines)
        try:
            now = os.stat(path)
        except FileNotFoundError:
            now = None
        here = os.fstat(stream.fileno())
        if now is not None and ((now.st_dev, now.st_ino) != (here.st_dev, here.st_ino)
                                or now.st_size < stream.tell()):
            # Read what the old file still held before the switch, so that no line of
            # it is lost; the new file's lines are all new.
            emit(out, (pending + stream.read()).split(b"\n")[:-1])
            stream.close()
            stream, pending = None, b""
            continue
        time.sleep(poll)
    return DONE


def watch_events(project, old):
    """Run jig orch <project> events, with --old when old is true."""
    path = events_path(project)
    out = sys.stdout.buffer
    if old:
        try:
            data = path.read_bytes()
        except FileNotFoundError:
            return DONE
        except OSError as error:
            print(f"jig orch: cannot read {path}: {error.strerror}", file=sys.stderr)
            return REFUSED
        emit(out, old_events(data.split(b"\n")[:-1]))
        return DONE
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop_watching)
    try:
        return follow(path, out)
    except Stopped:
        return DONE
    except BrokenPipeError:
        # The reader is gone, as when the session that ran the watcher has ended. Python
        # would flush the closed pipe again at exit and print an error about it.
        os.dup2(os.open(os.devnull, os.O_WRONLY), out.fileno())
        return DONE
    except OSError as error:
        print(f"jig orch: cannot read {path}: {error.strerror}", file=sys.stderr)
        return REFUSED


def wait_on(project, words, poll):
    """jig orch <project> wait-on: list, write or clear the waits of the project."""
    waits_file = orch_dir(project) / WAITS_FILE
    now = datetime.datetime.now().astimezone()
    account = orch_accounts(project_conf(project))[0]
    home = account_home(account)
    if not words:
        lines = wait_lines(project, home, now, poll)
        print("\n".join(f"jig orch: {project}: {line}" for line in lines)
              or f"jig orch: {project}: no waits")
        return DONE
    other, rest = words[0], words[1:]
    if other == project or not jig_units.PROJECT.fullmatch(other):
        print(f"jig orch: usage: wait-on takes the name of another project, not {other!r}",
              file=sys.stderr)
        return USAGE
    clear = rest == ["--clear"]
    if "--clear" in rest and not clear:
        print("jig orch: usage: wait-on <other> --clear takes nothing more", file=sys.stderr)
        return USAGE
    what = " ".join(rest).replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()
    if not clear and not what:
        print("jig orch: usage: wait-on <other> takes the thing it waits for, or --clear",
              file=sys.stderr)
        return USAGE
    # A mistyped name on either side would leave a wait that no loop reads, so both
    # orch directories must exist already; the command makes neither. The directory
    # of the other project is the one whose activity file the stall check reads.
    if not clear:
        for directory, name in ((orch_dir(project), project),
                                (other_orch_dir(home, other) if home else None, other)):
            if directory is None:
                print(f"jig orch: refused: wait-on: the orchestrator account {account} is "
                      f"not known, so no activity file of {other} can be read",
                      file=sys.stderr)
                return REFUSED
            if not directory.is_dir():
                print(f"jig orch: refused: wait-on: {directory} does not exist: no "
                      f"orchestrator of {name} runs on this host", file=sys.stderr)
                return REFUSED
    try:
        old = waits_file.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        old = []
    mine = [line for line in old if line.split("\t", 1)[0] == other]
    kept = [line for line in old if line.split("\t", 1)[0] != other]
    if clear:
        if mine:
            write_whole(waits_file, "".join(f"{line}\n" for line in kept))
            print(f"jig orch: {project} no longer waits on {other}")
        else:
            print(f"jig orch: {project} did not wait on {other}")
        return DONE
    since = stamp(now)
    for line in mine:
        fields = line.split("\t")
        if len(fields) == 3 and fields[2] == what and parse_stamp(fields[1]):
            since = fields[1]
    lines = [*kept, f"{other}\t{since}\t{what}"]
    write_whole(waits_file, "".join(f"{line}\n" for line in lines))
    print(f"jig orch: {project} waits on {other} since {since}: {what}")
    found = read_activity(other_orch_dir(home, other) / ACTIVITY_FILE)
    shown = describe(found, now, poll)
    if shown.startswith("no activity file"):
        print(f"jig orch: warning: {other} has {shown}: its loop writes none, because it "
              f"runs a jig older than 0.8.0 or no loop runs, so it shows as down")
    return DONE


class Orch:
    def __init__(self, project):
        self.project = project
        self.session = f"{project}-orch"
        conf = self.conf = jig_units.read_conf(project)
        self.clone = pathlib.Path(conf["REPO"])
        self.branch = conf["BRANCH"]
        # A ref of the loop's own, so that its fetch moves nothing that other fetches use.
        self.watch_ref = f"refs/jig-orch/{self.branch}"
        self.standing = self.clone / "impl" / "orch" / "ORCHESTRATOR.md"
        reviews = pathlib.Path.home() / "ws" / "reviews" / project
        self.state = reviews / "orch"
        self.lock = self.state / "loop.lock"
        self.log_path = self.state / "supervisor.log"
        self.events_file = self.state / EVENTS_FILE
        self.ids_file = self.state / "session-ids"
        self.announced_file = self.state / "announced"
        self.reported_file = self.state / "reported"
        self.reminded_file = self.state / "reminded"
        self.activity_file = self.state / ACTIVITY_FILE
        self.waits_file = self.state / WAITS_FILE
        self.state_md = self.clone / "impl" / "orch" / "state.md"
        self.fetch_err = self.state / "fetch.err"
        self.tee = reviews / "out" / "orch.txt"
        self.transcripts = reviews / "transcripts" / "orch"
        root = os.environ.get("JIG_SRV") or SRV_ROOT
        self.srv = pathlib.Path(root)
        self.watched = (("inbox", pathlib.Path(root) / "in" / project),
                        ("readback", pathlib.Path(root) / "out" / project))
        self.srv_root = root
        self.directories = jig_dirs.with_srv(jig_dirs.of_role("orch", project), root)
        self.account = conf.get("ORCH_ACCOUNT") or "orchestrator"

    # The log and the tee.

    def log(self, text, tee=False):
        line = f"{now_text()} {text}\n"
        with open(self.log_path, "a", encoding="utf-8") as stream:
            stream.write(line)
        if tee:
            self.tee.parent.mkdir(parents=True, exist_ok=True)
            with open(self.tee, "a", encoding="utf-8") as stream:
                stream.write(f"\njig orch: {line}")

    def last_log_line(self):
        """Return the last line of the log that says what the loop did.

        The two lines of the last look for forks come after the line that says why
        the loop ended, so they are passed over.
        """
        try:
            lines = self.log_path.read_text(encoding="utf-8").splitlines()
        except OSError:
            return None
        for line in reversed(lines):
            text = line.split(" ", 1)[-1]
            if not text.startswith(("looked for forks of ", "looked again for forks of ")):
                return line
        return None

    # The session.

    def pane(self):
        """Return the session's pane, or None when the session does not exist."""
        result = worker.tmux("display-message", "-p", "-t", f"={self.session}:", PANE_FORMAT)
        if result.returncode != 0:
            return None
        try:
            return Pane(result.stdout.rstrip("\n"))
        except ValueError:
            return None

    def alive(self):
        # With remain-on-exit the session outlives Claude Code, so a session that exists
        # can hold a dead pane: only a live pane counts.
        pane = self.pane()
        return pane is not None and not pane.dead

    def ours(self, pane=None):
        """Say whether the session is the one the loop started last, not one of a person.

        Both IDs must match the record: the tmux session ID, which a respawn keeps, and
        the Claude Code session ID in the pane's start command, which each respawn
        changes. A session that a person made under the same name has another tmux ID;
        a pane that a person respawned has another Claude Code ID.
        """
        pane = pane or self.pane()
        if pane is None:
            return False
        try:
            recorded = self.ids_file.read_text(encoding="utf-8").split()
        except OSError:
            return False
        return recorded == [pane.session_id, pane.claude_session()]

    def foreign(self):
        return (f"tmux session {self.session} is not the loop's own: its tmux or Claude "
                f"Code session ID differs from {self.ids_file}")

    def prepare(self, say, warn, quiet=False):
        """Find the folders of the next session and mark them as trusted.

        The folders are the orchestrator's list and the orchestrator's folders in the
        section Directories of the kickoff record, read anew each time, since a new
        kickoff tag can change them. Each line of that section that jig cannot read
        goes to warn, unless quiet. A folder outside the approved list of the account
        is refused: the result is then None and the line of the refusal. Otherwise the
        -dev clone and each folder that exists get the trust mark of Claude Code, so
        that the session does not wait at a dialog, with a line to say for each mark
        set or not set, and the result is the folders to pass and None.
        """
        homes = jig_dirs.homes_of(self.conf)
        found, problems = jig_dirs.read_directories(jig_profile.read_record(self.clone),
                                                    homes, self.project)
        for line in [] if quiet else problems:
            warn(line)
        extra = found["orchestrator"]
        candidates = [*self.directories, *extra]
        approved = jig_dirs.approved_list(self.conf, self.account, self.project, extra,
                                          self.srv_root)
        outside = jig_dirs.first_outside(candidates, approved, homes["orchestrator"])
        if outside is not None:
            return None, (f"{outside} is not in the approved list of the folders of "
                          f"{self.account}; no session was started")
        passed = worker.existing_dirs(candidates)
        marks = [(str(self.clone), jig_trust.TRUST_KEY)]
        marks += [(folder, jig_trust.ADDED_FOLDER_KEY) for folder in passed]
        # One read and one rename for all the marks, as jig start does.
        for folder, value, problem in jig_trust.mark_all(marks, self.account):
            if value == jig_trust.KEPT:
                continue
            if problem:
                say(problem)
            say(f"trust {self.account} {folder}: {value}")
        return passed, None

    def launch(self, first=False):
        """Start the next Claude Code session; return False when the loop must stop.

        A session that does not exist is made anew. The loop's own session with a dead
        pane gets the new Claude Code in that pane, so that a person's attached client
        stays. Any other session is left as it is. Before it, the folders are read and
        marked again; their lines go to the log. The first session of a loop is the one
        that jig orch start has prepared and reported on already, so its lines of the
        section that cannot be read are not written twice.
        """
        pane = self.pane()
        if pane is None:
            return self.open_prepared(None, first)
        if not self.ours(pane):
            self.log(f"stopped: {self.foreign()}; the loop starts nothing in it and "
                     f"leaves it as it is", tee=True)
            return False
        if not pane.dead:
            self.log(f"stopped: tmux session {self.session} has a live pane that this "
                     f"loop did not start", tee=True)
            return False
        return self.open_prepared(pane, first)

    def open_prepared(self, pane, first):
        """Prepare the folders and open the session; return False after a refusal."""
        folders, refusal = self.prepare(self.log, self.log, quiet=first)
        if refusal:
            self.log(f"stopped: {refusal}", tee=True)
            return False
        self.open_session(pane, folders)
        return True

    def open_session(self, pane, folders):
        """Start Claude Code in a new session, or, given the dead pane, in that pane."""
        self.run = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
        self.claude_session = str(uuid.uuid4())
        try:
            worker.set_effort(str(self.clone), MODEL, EFFORT)
        except worker.Refused as error:
            self.log(f"cannot set the effort: {error}", tee=True)
            return
        # The start line goes in first, so that every event appended from now on lies
        # after it, where the new session's watcher reads.
        failure = self.append_event(f"start {self.claude_session}")
        if failure:
            self.log(f"cannot start session {self.session}: cannot append its start line "
                     f"to {self.events_file}: {failure}", tee=True)
            return
        channel = f"jig-orch-{self.session}"
        add_dirs = "".join(f"--add-dir {shlex.quote(directory)} " for directory in folders)
        # The pane waits for the channel before Claude Code runs, so that the options
        # and the tee below are in place before it can write or exit.
        inner = (
            f"export PATH={shlex.quote(os.environ.get('PATH', ''))}:$PATH; "
            "unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT; "
            f"tmux wait-for {shlex.quote(channel)}; "
            f"exec claude {add_dirs}--model {MODEL} --effort {EFFORT} "
            f"--name {shlex.quote(self.session)} --remote-control {shlex.quote(self.session)} "
            f"--session-id {self.claude_session} "
            f'"$(cat {shlex.quote(str(self.standing))})"'
        )
        command = worker.session_command(inner)
        target = f"={self.session}:"
        if pane is None:
            made = worker.tmux("new-session", "-d", "-s", self.session, "-x", "200",
                               "-y", "50", "-c", str(self.clone), command)
            how = "start"
        else:
            made = worker.tmux("respawn-pane", "-k", "-t", target, "-c", str(self.clone),
                               command)
            how = "respawn"
        if made.returncode != 0:
            self.log(f"cannot {how} session {self.session}: {worker.last_line(made)}",
                     tee=True)
            return
        # Set before the pane is released: a Claude Code that exits at once would
        # otherwise take the session, and a person's client, with it.
        option = worker.tmux("set-option", "-w", "-t", target, "remain-on-exit", "on")
        if option.returncode != 0:
            self.log(f"cannot set remain-on-exit on session {self.session}: "
                     f"{worker.last_line(option)}", tee=True)
        pane = self.pane()
        if pane is not None:
            self.ids_file.write_text(f"{pane.session_id} {self.claude_session}\n",
                                     encoding="utf-8")
            # tmux keeps a pane's pipe across the death and the respawn of the pane, and
            # pipe-pane -o closes a pipe that is open, so the tee is opened only when the
            # pane has none; otherwise the old pipe goes on into the same file.
            if not pane.piped:
                self.tee.parent.mkdir(parents=True, exist_ok=True)
                worker.tmux("pipe-pane", "-o", "-t", target,
                            f"cat >> {shlex.quote(str(self.tee))}")
        worker.tmux("wait-for", "-S", channel)
        self.log(f"started session {self.session}, Claude Code session {self.claude_session}"
                 + (" in the same pane" if how == "respawn" else ""))

    def end_claude(self, pane):
        """End Claude Code in the pane: SIGTERM, then SIGKILL when it still runs.

        The pane runs Claude Code itself, because its command execs down to claude; the
        pane stays, dead, so that an attached client stays too.
        """
        try:
            os.kill(pane.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + END_WAIT_SECONDS
        while time.monotonic() < deadline:
            now = self.pane()
            if now is None or now.dead or now.pid != pane.pid:
                return
            time.sleep(0.2)
        try:
            os.kill(pane.pid, signal.SIGKILL)
        except ProcessLookupError:
            return
        self.log(f"Claude Code in session {self.session} did not end on SIGTERM within "
                 f"{END_WAIT_SECONDS:.0f} s; sent SIGKILL")
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            now = self.pane()
            if now is None or now.dead or now.pid != pane.pid:
                return
            time.sleep(0.1)

    def copy_transcript(self):
        found = sorted(pathlib.Path.home().glob(
            f".claude/projects/*/{self.claude_session}.jsonl"))
        if not found:
            self.log(f"no transcript of Claude Code session {self.claude_session} to copy")
            return
        target = self.transcripts / self.run
        target.mkdir(parents=True, exist_ok=True)
        for path in found:
            shutil.copy2(path, target / path.name)
        self.log(f"copied the transcript to {target}")

    # The forks of an old session.

    def end_forks(self, session_id):
        """Send SIGTERM to each process of this account that resumes the session."""
        for pid, arguments in own_processes():
            if pid == os.getpid() or (pid, session_id) in self.ended_forks \
                    or not resumes(arguments, session_id):
                continue
            # Signalled once: a pid seen again at the next poll gets no second line.
            self.ended_forks.add((pid, session_id))
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                self.log(f"pid {pid}, a fork of the old Claude Code session {session_id}, "
                         f"ended before the signal")
                continue
            except OSError as error:
                self.log(f"cannot end pid {pid}, a fork of the old Claude Code session "
                         f"{session_id}: {error.strerror}", tee=True)
                continue
            self.log(f"sent SIGTERM to pid {pid}, a fork of the old Claude Code session "
                     f"{session_id}")

    def watch_forks(self):
        """Look for forks of each old session whose window after the restart is open."""
        moment = time.monotonic()
        self.fork_watch = {session_id: end for session_id, end in self.fork_watch.items()
                           if moment < end}
        for session_id in self.fork_watch:
            self.end_forks(session_id)

    def recorded_session(self):
        """Return the Claude Code session ID in orch/session-ids, or None."""
        try:
            recorded = self.ids_file.read_text(encoding="utf-8").split()
        except OSError:
            return None
        return recorded[1] if len(recorded) == 2 else None

    def last_looks(self, sessions, window):
        """Look for forks of these sessions now and once more after the window.

        A fork can start a while after its session has exited, and once the loop is
        gone nothing else would end it; the next start would then run a second
        orchestrator beside it.
        """
        sessions = [session_id for session_id in dict.fromkeys(sessions) if session_id]
        if not sessions:
            return
        for session_id in sessions:
            self.end_forks(session_id)
        named = ("session " if len(sessions) == 1 else "sessions ") + ", ".join(sessions)
        self.log(f"looked for forks of Claude Code {named}; looks again in {window:g} s")
        # A plain sleep: a second stop signal must not cut the second look short.
        time.sleep(window)
        for session_id in sessions:
            self.end_forks(session_id)
        self.log(f"looked again for forks of Claude Code {named}")

    # The inbox and the readbacks.

    def files(self, directory):
        """Return {path: (inode, mtime in ns, size)} of the directory's files.

        Return None when the directory cannot be read.
        """
        found = {}
        try:
            with os.scandir(directory) as entries:
                for entry in entries:
                    if entry.is_file(follow_symlinks=False) and not entry.name.startswith("."):
                        status = entry.stat(follow_symlinks=False)
                        found[entry.path] = (status.st_ino, status.st_mtime_ns, status.st_size)
        except OSError:
            return None
        return found

    def read_announced(self):
        """Return {path: (inode, mtime in ns)} of the files announced by earlier loops.

        Return None when there is no record.
        """
        try:
            text = self.announced_file.read_text(encoding="utf-8")
        except FileNotFoundError:
            return None
        except OSError as error:
            self.log(f"cannot read {self.announced_file}: {error.strerror}; starting a new "
                     "record", tee=True)
            return None
        record = {}
        for line in text.splitlines():
            match = RECORD_LINE.fullmatch(line)
            if match:
                record[match[3]] = (int(match[1]), int(match[2]))
                continue
            if not line:
                continue
            # Before inodes were kept a line was a path alone. It stands for the file at
            # that path now, so that the first start after an upgrade appends no line again.
            try:
                status = os.stat(line, follow_symlinks=False)
            except OSError:
                continue
            record[line] = (status.st_ino, status.st_mtime_ns)
        return record

    def write_announced(self):
        temporary = self.announced_file.with_name(self.announced_file.name + ".new")
        try:
            temporary.write_text("".join(f"{inode} {mtime} {path}\n" for path, (inode, mtime)
                                         in sorted(self.announced.items())), encoding="utf-8")
            os.replace(temporary, self.announced_file)
        except OSError as error:
            self.log(f"cannot write {self.announced_file}: {error.strerror}", tee=True)

    def scan(self):
        """Queue a line for each new file that held still since the last poll.

        A file is new when its inode or modification time differs from those announced
        for its path, so a readback written again, or an inbox file that grew, is
        announced again. A path whose file is gone drops out of the record, so a file
        written there later is new even when it gets the same inode back.
        A directory that cannot be read is skipped, so that its files are not new again.

        self.seen holds the files that are queued or announced, so that a file whose
        line still waits is not queued twice; self.announced, the written record, gets a
        file only once its line is appended (append_queue).
        """
        before = dict(self.announced)
        for kind, directory in self.watched:
            present = self.files(directory)
            if present is None:
                continue
            inside = {path for path in [*self.seen, *self.announced, *self.waiting]
                      if os.path.dirname(path) == str(directory)}
            for path in inside - set(present):
                self.seen.pop(path, None)
                self.announced.pop(path, None)
                self.waiting.pop(path, None)
            for path, (inode, mtime, size) in sorted(present.items()):
                if self.seen.get(path) == (inode, mtime):
                    continue
                if self.waiting.get(path) != (inode, mtime, size):
                    self.waiting[path] = (inode, mtime, size)
                    continue
                del self.waiting[path]
                self.seen[path] = (inode, mtime)
                self.queue.append((self.announcement(kind, path, size),
                                   FileMark(path, inode, mtime)))
        if self.announced != before:
            self.write_announced()

    def announcement(self, kind, path, size):
        if kind == "readback":
            name = os.path.basename(path)
            return f"readback: {name[:-4] if name.endswith('.txt') else name}"
        digest = hashlib.sha256()
        try:
            with open(path, "rb") as stream:
                for block in iter(lambda: stream.read(1 << 16), b""):
                    digest.update(block)
        except OSError as error:
            return f"inbox: {path} ({size}, sha256 unreadable: {error.strerror})"
        return f"inbox: {path} ({size}, sha256 {digest.hexdigest()[:8]})"

    # The report commits on origin. A unit ends with a commit whose subject is "log: <ID>"
    # and that holds impl/log/<ID>-report.md; the first line of that file is its status.

    def read_reported(self):
        """Return the commits announced by earlier loops, or None when there is no record."""
        try:
            return set(self.reported_file.read_text(encoding="utf-8").split())
        except FileNotFoundError:
            return None
        except OSError as error:
            self.log(f"cannot read {self.reported_file}: {error.strerror}; starting a new "
                     "record", tee=True)
            return None

    def write_reported(self):
        temporary = self.reported_file.with_name(self.reported_file.name + ".new")
        try:
            temporary.write_text("".join(f"{commit}\n" for commit in sorted(self.reported)),
                                 encoding="utf-8")
            os.replace(temporary, self.reported_file)
        except OSError as error:
            self.log(f"cannot write {self.reported_file}: {error.strerror}", tee=True)

    def read_reminded(self):
        """Return the (item, date) pairs that earlier loops appended, from lines
        "<date> <item>"."""
        try:
            lines = self.reminded_file.read_text(encoding="utf-8").splitlines()
        except FileNotFoundError:
            return set()
        except OSError as error:
            self.log(f"cannot read {self.reminded_file}: {error.strerror}; starting a new "
                     "record", tee=True)
            return set()
        return {(item, date) for date, _, item in (line.partition(" ") for line in lines)
                if item}

    def write_reminded(self):
        temporary = self.reminded_file.with_name(self.reminded_file.name + ".new")
        try:
            temporary.write_text("".join(f"{date} {item}\n"
                                         for item, date in sorted(self.reminded)),
                                 encoding="utf-8")
            os.replace(temporary, self.reminded_file)
        except OSError as error:
            self.log(f"cannot write {self.reminded_file}: {error.strerror}", tee=True)

    # The reminders of dated Open items in state.md. Each queued line carries its
    # (item, date) pair, which goes into the record only once the line is appended, so a
    # reminder that a stop drops while it waits goes out after the restart.

    def remind(self):
        try:
            text = self.state_md.read_text(encoding="utf-8")
        except OSError as error:
            problem = f"reminders: cannot read {self.state_md}: {error.strerror}"
            if problem != self.remind_problem:
                self.remind_problem = problem
                self.log(problem)
            return
        self.remind_problem = None
        waiting = {mark for _, mark in self.queue if isinstance(mark, tuple)}
        for item, date in due_items(text, datetime.date.today()):
            if (item, date) in self.reminded or (item, date) in waiting:
                continue
            self.queue.append((f"reminder: {item}", (item, date)))
            self.log(f"reminders: queued the item due {date}")

    def start_fetch(self):
        # Without the empty --refmap, git would also move refs/remotes/origin/<branch>
        # through the remote's fetch mapping, under a fetch that jig wait may be running.
        command = ["git", "-C", str(self.clone), "fetch", "-q", "--no-write-fetch-head",
                   "--no-auto-maintenance", "--refmap=", "origin",
                   f"+refs/heads/{self.branch}:{self.watch_ref}"]
        # A fetch that asked for a password or a host key would wait for an answer forever.
        env = dict(os.environ, GIT_TERMINAL_PROMPT="0",
                   GIT_SSH_COMMAND="ssh -o BatchMode=yes")
        try:
            with open(self.fetch_err, "wb") as errors:
                # A group of its own lets a fetch that hangs be ended with its ssh child.
                self.fetching = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                                 stdout=subprocess.DEVNULL, stderr=errors,
                                                 env=env, start_new_session=True)
        except OSError as error:
            self.fetching = None
            self.fetch_failed(f"cannot run git: {error.strerror}")
            return
        self.fetch_deadline = time.monotonic() + self.fetch_cap

    def end_fetch(self):
        """End a fetch that still runs, with every process it started."""
        if self.fetching is None:
            return
        if self.fetching.poll() is None:
            try:
                os.killpg(self.fetching.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            self.fetching.wait()
        self.fetching = None

    def fetch_failed(self, failure):
        # One line for a run of failures: an origin that is down for an hour would
        # otherwise fill the log and the tee with the same line.
        if not self.fetch_failing:
            self.log(f"cannot fetch {self.branch} from origin in {self.clone}: {failure}; "
                     f"report lines wait until a fetch works, tried every "
                     f"{self.report_poll:g} s", tee=True)
        self.fetch_failing = True

    def follow_branch(self):
        """Read BRANCH from the conf file again, and watch the new branch when it moved.

        The conf file of a project moves to a new version line while the loop runs. A
        loop that kept the branch of its start would go on fetching the old line, and
        the report commits of the new line would get no line. The ref of the old branch
        stays as it was last fetched, so that the first fetch of the new branch can
        leave out the reports that the old branch already held.
        """
        try:
            branch = jig_units.read_conf(self.project)["BRANCH"]
        except worker.Refused as error:
            problem = f"branch: {error}; reports still come from {self.branch}"
            if problem != self.branch_problem:
                self.branch_problem = problem
                self.log(problem)
            return
        self.branch_problem = None
        if branch == self.branch:
            return
        self.log(f"branch: BRANCH of the conf file moved from {self.branch} to {branch}; "
                 f"reports now come from {branch}")
        # After two moves with no fetch between them, the branch fetched last is still
        # the one whose reports were seen.
        if self.moved_from is None:
            self.moved_from = self.watch_ref
        self.branch, self.watch_ref = branch, f"refs/jig-orch/{branch}"
        # The diff from the old line's head to the new one's is no news of this hour.
        self.origin_head = None

    def watch_reports(self):
        """Start a fetch when one is due, and look for new report commits after it.

        The fetch runs beside the loop, so that inbox lines and the dialog check go on
        while it waits on the network.
        """
        moment = time.monotonic()
        if self.fetching is None:
            if moment >= self.next_fetch:
                self.next_fetch = moment + self.report_poll
                self.follow_branch()
                self.start_fetch()
            return
        code = self.fetching.poll()
        if code is None and moment < self.fetch_deadline:
            return
        self.end_fetch()
        if code is None:
            self.fetch_failed(f"no answer within {self.fetch_cap:g} s")
            return
        if code != 0:
            try:
                lines = self.fetch_err.read_text(encoding="utf-8", errors="replace").split("\n")
            except OSError:
                lines = []
            lines = [line for line in lines if line.strip()]
            self.fetch_failed(lines[-1] if lines else f"git fetch exit {code}")
            return
        if self.fetch_failing:
            self.log(f"fetch of {self.branch} from origin works again")
        self.fetch_failing = False
        self.watch_changes()
        self.find_reports()

    def find_reports(self):
        listed = worker.git(self.clone, "log", "--reverse", "--extended-regexp",
                            "--grep=^log: ", "--format=%H %ct %s", self.watch_ref)
        if listed.returncode != 0:
            self.fetch_failed(f"cannot list {self.watch_ref}: {worker.last_line(listed)}")
            return
        commits = []
        for line in listed.stdout.splitlines():
            commit, _, rest = line.partition(" ")
            moment, _, subject = rest.partition(" ")
            unit = subject[len("log: "):] if subject.startswith("log: ") else ""
            if jig_ids.is_unit_id(unit) and moment.isdigit():
                commits.append((commit, int(moment), unit))
        if self.reported is None:
            # The record is made from origin as the first fetch that works finds it. A log
            # commit made since the loop started is left out, so that a report that landed
            # while the first fetches failed still gets its line.
            self.reported = {commit for commit, moment, _ in commits
                             if moment < int(self.loop_started)}
            self.write_reported()
        if self.moved_from is not None:
            # The first fetch of a new branch. A report that the old branch held got its
            # line there, or was taken as announced there; a report older than the loop
            # was made while no loop watched this branch, and is old news.
            held = worker.git(self.clone, "log", "--extended-regexp", "--grep=^log: ",
                              "--format=%H", self.moved_from)
            old = set(held.stdout.split()) if held.returncode == 0 else set()
            self.reported |= {commit for commit, moment, _ in commits
                              if commit in old or moment < int(self.loop_started)}
            self.write_reported()
            self.moved_from = None
        for commit, _, unit in commits:
            if commit in self.reported or commit in self.pending:
                continue
            status = closing.report_status(self.clone, commit, unit) or "unreadable"
            self.pending.add(commit)
            self.queue.append((f"report: {unit} {status}", commit))

    # The hourly tick. Something changed since the last tick when the loop appended an
    # inbox, readback or report line to the event file, or when origin got a commit that
    # changes a file other than the update log. Then the tick writes nothing; else the
    # loop writes the idle line itself. Neither wakes the model, so that a quiet hour
    # costs no model time.

    def note_change(self):
        self.changed = True
        self.last_change = now_text()

    def watch_changes(self):
        """Compare the fetched ref with the one at the last fetch that worked."""
        head = worker.git_out(self.clone, "rev-parse", "-q", "--verify", self.watch_ref)
        if not head or head == self.origin_head:
            return
        old, self.origin_head = self.origin_head, head
        # The first fetch that works sets the baseline, as it sets the report record.
        if old is None:
            return
        changed = worker.git(self.clone, "diff", "--name-only", "--no-renames", old, head)
        # When the two cannot be compared, a change is the safer guess: it costs at most
        # one missing idle line, where a wrong idle line would hide work.
        if changed.returncode != 0 or any(name != UPDATES_LOG
                                          for name in changed.stdout.splitlines()):
            self.note_change()

    def tick(self):
        moment = time.monotonic()
        if moment < self.next_tick:
            return
        self.next_tick = moment + self.hourly
        self.remind()
        if self.changed:
            self.changed = False
            self.log(f"hourly: something changed since the last tick, at {self.last_change}; "
                     f"no idle line")
            return
        shown = worker.git(self.clone, "show", f"{self.watch_ref}:{STATUS_LOG}")
        line = (f"{now_text()} idle: waits for "
                f"{waited_for(shown.stdout if shown.returncode == 0 else None)} "
                f"since {self.last_change}\n")
        path = self.clone / UPDATES_LOG
        try:
            with open(path, "a", encoding="utf-8") as stream:
                stream.write(line)
        except OSError as error:
            self.log(f"hourly: nothing changed; cannot write the idle line to {path}: "
                     f"{error.strerror}", tee=True)
            return
        self.log(f"hourly: nothing changed since {self.last_change}; wrote the idle line")

    # The loop.

    def stop_request(self, signum, frame):
        self.stopping = True

    def append_event(self, line):
        """Append one line to the event file; return None, or why it failed.

        The line goes out in one write to a file opened for appending, so that a line
        that a block appends at the same time is not mixed into it.
        """
        try:
            descriptor = os.open(self.events_file, os.O_WRONLY | os.O_APPEND | os.O_CREAT,
                                 0o644)
        except OSError as error:
            return error.strerror
        try:
            data = f"{line}\n".encode("utf-8")
            if os.write(descriptor, data) != len(data):
                return "the line was written only in part"
        except OSError as error:
            return error.strerror
        finally:
            os.close(descriptor)
        return None

    def rest(self, seconds):
        """Wait for the next poll, in short steps, so that a stop is not kept waiting."""
        end = time.monotonic() + seconds
        while not self.stopping:
            moment = time.monotonic()
            if moment >= end:
                return
            time.sleep(min(end - moment, 0.5))

    def append_queue(self):
        """Append the queued events to the event file, oldest first."""
        while self.queue and not self.stopping:
            # The mark of a line is its report commit, the (item, date) pair of a
            # reminder, the FileMark of an inbox file or readback, or QUIET for a stall
            # or resumed line.
            line, mark = self.queue[0]
            failure = self.append_event(line)
            if failure:
                # The line stays at the head of the queue, so that the lines keep their
                # order, and the next poll tries again. It is logged once, not at every
                # poll that it waits.
                if self.held != line:
                    self.held = line
                    self.log(f"cannot append to {self.events_file} ({failure}), tried "
                             f"again at the next poll: {line}", tee=True)
                return
            self.queue.pop(0)
            again = " after a failure" if self.held == line else ""
            self.held = None
            self.log(f"appended{again}: {line}")
            if not isinstance(mark, (tuple, QuietMark)):
                self.note_change()
            # A report commit, a reminder or a file goes into its record only once its
            # line is appended, so that a line that a stop drops while it waits in the
            # queue is appended after the restart.
            if isinstance(mark, QuietMark):
                pass
            elif isinstance(mark, tuple):
                self.reminded.add(mark)
                self.write_reminded()
            elif isinstance(mark, FileMark):
                self.announced[mark.path] = (mark.inode, mark.mtime)
                self.write_announced()
            elif mark:
                self.pending.discard(mark)
                self.reported.add(mark)
                self.write_reported()

    def loop(self, poll, report_poll, hourly, fork_window, activity, stall_override):
        self.stopping = False
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, self.stop_request)
        self.loop_started = time.time()
        self.log(f"loop started, pid {os.getpid()}")
        # Paths that are gone drop out of the record at the first scan of their directory.
        self.seen = self.read_announced()
        if self.seen is None:
            self.seen = {}
            for _, directory in self.watched:
                for path, (inode, mtime, _) in (self.files(directory) or {}).items():
                    self.seen[path] = (inode, mtime)
        self.announced = dict(self.seen)
        # Written at once, so that a record of the older form is not read a second time.
        self.write_announced()
        self.reported, self.pending = self.read_reported(), set()
        self.report_poll = report_poll
        self.fetch_cap = min(FETCH_CAP_SECONDS, report_poll)
        self.fetching, self.fetch_failing, self.next_fetch = None, False, 0.0
        self.moved_from, self.branch_problem = None, None
        self.waiting, self.queue, self.held = {}, [], None
        self.hourly, self.next_tick = hourly, time.monotonic() + hourly
        self.changed, self.last_change, self.origin_head = False, now_text(), None
        self.fork_window, self.fork_watch, self.ended_forks = fork_window, {}, set()
        self.reminded, self.remind_problem = self.read_reminded(), None
        self.remind()
        self.problems = {}
        # The old file gives the since of a state that goes on across the restart.
        self.activity = read_activity(self.activity_file)[0]
        self.activity_poll, self.next_activity = activity, time.monotonic()
        seconds, problem = stall_time(self.srv)
        if problem:
            self.log(f"stall time: {problem}; the loop uses {STALL_MINUTES} minutes")
        self.stalls = Stalls(stall_override or seconds, activity)
        self.idle = Idle(self.project, stall_override or seconds,
                         datetime.datetime.now().astimezone())
        try:
            return self.supervise(poll)
        finally:
            self.end_fetch()
            # Whatever ended the loop, no loop writes the file any more.
            self.write_activity("down")
            # The sessions whose window is still open are looked at too: the loop
            # that ends would no longer watch them.
            # A loop whose first launch failed started no session; the loop before it
            # took the looks for the one it started.
            self.last_looks([getattr(self, "claude_session", None), *self.fork_watch],
                            self.fork_window)

    def supervise(self, poll):
        exits = []
        if not self.launch(first=True):
            return REFUSED
        no_bar, reported = 0, False
        while not self.stopping:
            self.tick()
            self.watch_forks()
            if not self.alive():
                old = self.claude_session
                self.end_forks(old)
                self.copy_transcript()
                moment = time.monotonic()
                exits = [past for past in exits if moment - past < QUICK_WINDOW_SECONDS]
                exits.append(moment)
                self.log(f"session {self.session} exited ({len(exits)} in 10 minutes)")
                if len(exits) >= QUICK_EXITS:
                    # The dead pane stays, so the next start respawns it.
                    self.log(f"stopped: session {self.session} exited {QUICK_EXITS} times in "
                             f"10 minutes, so the loop does not start it again; see the tee, "
                             f"then jig orch {self.project} start", tee=True)
                    return REFUSED
                if not self.launch():
                    return REFUSED
                # A fork can show up after the exit, so the loop keeps looking for a while.
                self.fork_watch[old] = time.monotonic() + self.fork_window
                no_bar, reported = 0, False
                continue
            self.scan()
            self.watch_reports()
            # Events go to the file whatever the screen shows, a dialog included: the
            # session reads them once the dialog is answered.
            self.append_queue()
            screen = jig_tmux.capture(self.session)
            if screen is not None and jig_tmux.has_input_bar(screen):
                no_bar, reported = 0, False
            elif screen is not None:
                no_bar += 1
                if no_bar >= jig_tmux.DIALOG_POLLS and not reported:
                    reported = True
                    self.log(f"dialog: session {self.session} shows no input bar; jig orch "
                             f"does not answer it: tmux attach -t {self.session}", tee=True)
            self.watch_activity(screen, no_bar)
            self.rest(poll)
        # The session stays, with its dead pane, so that an attached client stays; a
        # session that is not the loop's own is not touched at all.
        pane = self.pane()
        if pane is not None and not self.ours(pane):
            self.log(f"{self.foreign()}; left it as it is")
        elif pane is not None:
            if not pane.dead:
                self.end_claude(pane)
            self.copy_transcript()
        self.log("loop stopped by jig orch stop")
        return DONE

    # The activity file and the stall lines.

    def problem(self, key, text):
        """Log a problem that would repeat at every activity poll, once an hour."""
        moment = time.monotonic()
        if moment < self.problems.get(key, moment):
            return
        self.problems[key] = moment + PROBLEM_SECONDS
        self.log(text)

    def write_activity(self, state, now=None):
        now = now or datetime.datetime.now().astimezone()
        since = kept_since(self.activity, state, now, self.activity_poll)
        self.activity = (state, since, now)
        try:
            write_whole(self.activity_file, f"{state}\t{stamp(since)}\t{stamp(now)}\n")
        except OSError as error:
            self.problem("activity", f"cannot write {self.activity_file}: {error.strerror}")

    def watch_activity(self, screen, no_bar):
        """Once an activity poll, write the activity file, look for stalls and for an
        idle orchestrator."""
        moment = time.monotonic()
        if moment < self.next_activity:
            return
        self.next_activity = moment + self.activity_poll
        now = datetime.datetime.now().astimezone()
        state = activity_state(unit_running(self.conf, self.project, now), self.alive(),
                               no_bar, screen)
        self.write_activity(state, now)
        self.watch_waits(now)
        line = self.idle.step(state, self.state / WAITING_FILE, now)
        if line:
            # Through the queue, as a stall line, and no change for the hourly tick.
            self.queue.append((line, QUIET))
            self.log(f"queued: {line}")

    def watch_waits(self, now):
        try:
            text = self.waits_file.read_text(encoding="utf-8")
        except FileNotFoundError:
            text = ""
        except (OSError, UnicodeDecodeError) as error:
            self.problem("waits", f"cannot read {self.waits_file}: "
                                  f"{getattr(error, 'strerror', None) or error}")
            return
        waits, bad = parse_waits(text)
        if bad:
            self.problem("waits", f"{self.waits_file}: {bad} line(s) do not parse and are "
                                  f"left out")

        # The activity files are in the home of the orchestrator account; a conf file
        # without ORCH_ACCOUNT gets the account orchestrator, as for its approved list.
        account = orch_accounts(self.conf)[0]
        home = orch_home(self.conf)

        def read(other):
            if home is None:
                self.problem("activity home", f"the account {account} is not known, so "
                                              f"no activity file can be read; each "
                                              f"project waited on counts as down")
                return None, "missing"
            path = other_orch_dir(home, other) / ACTIVITY_FILE
            found = read_activity(path)
            if found[1] == "unparsed":
                self.problem(f"activity {other}", f"{path} cannot be read or does not "
                                                  f"parse; {other} counts as down")
            return found

        # Through the queue, so that these lines keep their order among the others.
        for line in self.stalls.step(waits, read, now):
            self.queue.append((line, QUIET))
            self.log(f"queued: {line}")

    # The commands.

    def loop_pid(self):
        try:
            return int(self.lock.read_text(encoding="utf-8").split()[0])
        except (OSError, ValueError, IndexError):
            return None

    def start(self):
        if not self.standing.is_file():
            worker.refuse("orchestrator", f"no standing prompt at {self.standing}")
        self.state.mkdir(parents=True, exist_ok=True)
        descriptor = try_lock(self.lock)
        if descriptor is None:
            worker.refuse("loop", f"a loop runs already, pid {self.loop_pid()}")
        try:
            pane = self.pane()
            if pane is not None and not self.ours(pane):
                worker.refuse("session", f"{self.foreign()}; jig orch leaves it as it is")
            if pane is not None and not pane.dead:
                worker.refuse("session", f"tmux session {self.session} exists with a live "
                                         f"pane, and no loop runs")
            refusal = self.prepare(lambda line: print(line, flush=True),
                                   lambda line: print(line, file=sys.stderr, flush=True))[1]
            if refusal:
                worker.refuse("folders", refusal)
            with open(self.log_path, "a", encoding="utf-8") as log:
                child = subprocess.Popen(
                    [sys.executable, str(pathlib.Path(__file__).resolve()), self.project,
                     "loop", str(descriptor)],
                    stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                    pass_fds=(descriptor,), start_new_session=True)
        finally:
            os.close(descriptor)
        deadline = time.monotonic() + START_WAIT_SECONDS
        while child.poll() is None and not self.alive() and time.monotonic() < deadline:
            time.sleep(0.1)
        if child.poll() is not None:
            print(f"jig orch: the loop ended at once: {self.last_log_line()}", file=sys.stderr)
            return REFUSED
        print(f"jig orch: started the loop, pid {child.pid}, for session {self.session} "
              f"(tmux attach -t {self.session}); log {self.log_path}")
        return DONE

    def stop(self):
        self.state.mkdir(parents=True, exist_ok=True)
        descriptor = try_lock(self.lock)
        pid, killed = None, False
        if descriptor is None:
            pid = self.loop_pid()
            if pid:
                os.kill(pid, signal.SIGTERM)
            # The stopping loop ends Claude Code and then looks for forks across the
            # window before it frees the lock, so the wait covers both.
            deadline = time.monotonic() + STOP_WAIT_SECONDS + self.fork_window
            while descriptor is None and time.monotonic() < deadline:
                time.sleep(0.2)
                descriptor = try_lock(self.lock)
            if descriptor is None and pid:
                os.kill(pid, signal.SIGKILL)
                killed = True
                time.sleep(0.5)
                descriptor = try_lock(self.lock)
        if descriptor is not None:
            os.close(descriptor)
        # The loop ends Claude Code as it stops; this is for a loop that did not get to
        # it, one killed above or one that died.
        pane = self.pane()
        own = pane is not None and self.ours(pane)
        if own and not pane.dead:
            self.end_claude(pane)
        # A loop that ended on the signal has looked for forks itself; for a loop that
        # was dead or had to be killed, stop takes both looks in its place.
        if pid is None or killed:
            self.ended_forks = set()
            last = self.recorded_session()
            if last:
                print(f"jig orch: looking for forks of Claude Code session {last} for "
                      f"{self.fork_window:g} s", flush=True)
            self.last_looks([last], self.fork_window)
        if pane is None:
            left = f"no session {self.session}"
        elif own:
            left = f"Claude Code has ended; session {self.session} stays with its dead pane"
        else:
            left = f"{self.foreign()}; left it as it is"
        if pid is None:
            print(f"jig orch: no loop runs for {self.project}; {left}")
        else:
            print(f"jig orch: stopped the loop, pid {pid}; {left}")
        return DONE

    def status(self, poll):
        self.state.mkdir(parents=True, exist_ok=True)
        descriptor = try_lock(self.lock)
        last = self.last_log_line() or "no log"
        pane = self.pane()
        own = "its own" if self.ours(pane) else "not its own"
        session = (f"session {self.session}: pane {pane.state() if pane else 'none'}, "
                   f"{own}")
        if descriptor is not None:
            os.close(descriptor)
            print(f"jig orch: {self.project}: no loop runs; {session}; last: {last}")
        else:
            print(f"jig orch: {self.project}: loop {self.loop_pid()} runs; {session}; "
                  f"last: {last}")
        now = datetime.datetime.now().astimezone()
        print(f"jig orch: {self.project}: activity: "
              f"{describe(read_activity(self.activity_file), now, poll)}")
        for line in wait_lines(self.project, orch_home(self.conf), now, poll):
            print(f"jig orch: {self.project}: {line}")
        # Only the line: whether it still holds a wait depends on the last end of a
        # unit, which only the running loop knows.
        print(f"jig orch: {self.project}: waiting: {waiting_line(self.state / WAITING_FILE)}")
        return NO_LOOP if descriptor is not None else DONE

    def inside(self, pane):
        """Say whether this command runs inside the pane: as a descendant of its process,
        or in a shell whose tmux pane and server are those of the pane."""
        pid = os.getpid()
        while pid > 1:
            if pid == pane.pid:
                return True
            pid = parent_of(pid)
        socket = os.environ.get("TMUX", "").split(",")[0]
        return bool(socket) and os.environ.get("TMUX_PANE") == pane.pane_id \
            and os.path.realpath(socket) == os.path.realpath(pane.socket)

    def rollover(self):
        """End the loop's own Claude Code session from inside it, so that the loop
        starts the next one, as on any exit.

        Each check refuses before anything is signalled. The process of the pane is
        Claude Code itself, because the pane's command execs down to claude, so it is
        the one process that gets the signal; its arguments must hold the session ID
        that the loop gave it, so that a pane that runs something else is never ended.
        """
        self.state.mkdir(parents=True, exist_ok=True)
        descriptor = try_lock(self.lock)
        if descriptor is not None:
            os.close(descriptor)
            worker.refuse("loop", f"no loop runs for {self.project}, so none would start "
                                  f"the next session; jig orch {self.project} start first")
        pane = self.pane()
        if pane is None or pane.dead:
            worker.refuse("session", f"tmux session {self.session} is not live")
        if not self.ours(pane):
            worker.refuse("session", f"{self.foreign()}; jig orch leaves it as it is")
        session_id = pane.claude_session()
        if not runs_session(pane.pid, session_id):
            worker.refuse("process", f"pid {pane.pid}, the process of the pane of "
                                     f"{self.session}, does not run with --session-id "
                                     f"{session_id}")
        if not self.inside(pane):
            worker.refuse("caller", f"this command does not run inside the pane of "
                                    f"{self.session}; only the session itself rolls over")
        # The caller's output ends with its session, so the line goes out first.
        print(f"jig orch: ending Claude Code session {session_id}, pid {pane.pid}, in "
              f"{self.session}; the loop starts the next session", flush=True)
        try:
            os.kill(pane.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        return DONE


def complete_lines(path):
    """Return the lines of a file that end in a newline; a missing file has none.

    A line still being written waits for its newline, so that it is never printed in
    part.
    """
    try:
        data = path.read_bytes()
    except FileNotFoundError:
        return []
    return data.split(b"\n")[:-1]


def mark_at_start(lines):
    """Return the mark that stands when there is no usable one: the line number of the
    last start line, so that the events of the running session count as new, or 0."""
    starts = start_indexes(lines)
    return starts[-1] + 1 if starts else 0


def read_mark(path, lines):
    """Return the mark in the mark file, or the mark at the last start line when the
    file is missing, does not hold one whole number, or points beyond the event file,
    as after the event file was replaced."""
    try:
        text = path.read_text(encoding="utf-8").strip()
    except (OSError, ValueError):
        return mark_at_start(lines)
    # int() would also take a sign, underscores and digits of other scripts, which
    # this command never writes: such a file is damaged, not a mark.
    if not WHOLE_NUMBER.fullmatch(text):
        return mark_at_start(lines)
    value = int(text)
    return value if value <= len(lines) else mark_at_start(lines)


def watched_units(words):
    """Return the units that events --next waits on, as (unit ID, minutes or None),
    or None when a word is not <ID> or <ID>:<minutes> with minutes above 0."""
    units = []
    for word in words:
        unit, colon, minutes = word.partition(":")
        if not jig_units.UNIT_ID.fullmatch(unit):
            return None
        if not colon:
            units.append((unit, None))
        elif WHOLE_NUMBER.fullmatch(minutes) and int(minutes) > 0:
            units.append((unit, minutes))
        else:
            return None
    return units


class Child:
    """One child jig wait of events --next, with its own output file, so that the
    output of one wait never runs into the output of another."""

    def __init__(self, project, unit, minutes):
        self.unit = unit
        command = os.environ.get("JIG_ORCH_WAIT") or str(
            pathlib.Path(__file__).resolve().parent / "jig-wait")
        words = [command, project, unit]
        if minutes is not None:
            words += ["--expected", minutes]
        self.output = tempfile.TemporaryFile()
        try:
            self.process = subprocess.Popen(words, stdin=subprocess.DEVNULL,
                                            stdout=self.output, stderr=subprocess.STDOUT)
        except BaseException:
            self.output.close()
            raise

    def lines(self):
        """Return the whole output of the wait as lines, then the line that tells how
        it ended."""
        code = self.process.returncode
        if code < 0:
            # Killed by a signal: give the code that a shell would show.
            code = 128 - code
        self.output.seek(0)
        shown = self.output.read().splitlines()
        text = [line.decode("utf-8", "replace").strip() for line in shown]
        last = next((line for line in reversed(text) if line), "no output")
        return shown + [f"jig wait {self.unit} exit {code}: {last}".encode("utf-8")]

    def end(self):
        """End the child and reap it; SIGKILL when SIGTERM is not enough."""
        try:
            if self.process.poll() is None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait()
        finally:
            self.output.close()


def next_events(project, path, mark_path, out, units, poll=FOLLOW_SECONDS):
    """Wait for the next event after the mark, print it and what came with it, and
    return; with unit IDs, also return when one of their jig waits ends without a
    report.

    The printed lines and the new mark go out with the end signals held back, so that a
    signal cannot fall between them: a line printed with no mark written would be
    printed again by the next run, and a mark written with no line printed would lose
    it.
    """
    parent = os.getppid()
    children = []
    try:
        for unit, minutes in units:
            children.append(Child(project, unit, minutes))
        mark, seen = None, None
        while os.getppid() == parent:
            try:
                state = os.stat(path)
                stamp = (state.st_dev, state.st_ino, state.st_size, state.st_mtime_ns)
            except FileNotFoundError:
                stamp = None
            if mark is None or stamp != seen:
                lines = complete_lines(path)
                if mark is None:
                    mark = read_mark(mark_path, lines)
                elif mark > len(lines):
                    # The file was replaced or cut short: its lines are all new, after
                    # its last start line.
                    mark = mark_at_start(lines)
                seen = stamp
                fresh = lines[mark:]
                if fresh:
                    shown = [line for line in fresh if line.strip() != HOURLY_LINE]
                    held = signal.pthread_sigmask(signal.SIG_BLOCK, END_SIGNALS)
                    try:
                        emit(out, shown)
                        mark = len(lines)
                        write_whole(mark_path, f"{mark}\n")
                    finally:
                        signal.pthread_sigmask(signal.SIG_SETMASK, held)
                    if shown:
                        return DONE
            for child in list(children):
                if child.process.poll() is None:
                    continue
                if child.process.returncode != WAIT_REPORT:
                    emit(out, child.lines())
                    return DONE
                # The report wakes the session by its own line in the event file.
                children.remove(child)
                child.end()
            time.sleep(poll)
        return DONE
    finally:
        for signum in END_SIGNALS:
            signal.signal(signum, signal.SIG_IGN)
        for child in children:
            child.end()


def watch_next(project, units):
    """Run jig orch <project> events --next, with a jig wait on each unit given."""
    path = events_path(project)
    out = sys.stdout.buffer
    for signum in END_SIGNALS:
        signal.signal(signum, stop_watching)
    try:
        return next_events(project, path, path.with_name(MARK_FILE), out, units)
    except Stopped:
        return DONE
    except BrokenPipeError:
        # The reader is gone; Python would flush the closed pipe again at exit.
        os.dup2(os.open(os.devnull, os.O_WRONLY), out.fileno())
        return DONE
    except OSError as error:
        print(f"jig orch: cannot read or mark {path}: {error.strerror}", file=sys.stderr)
        return REFUSED


def main(argv):
    commands = ("start", "stop", "status", "rollover")
    hidden = len(argv) == 3 and argv[1] == "loop" and argv[2].isdigit()
    watcher = argv[1:] in (["events"], ["events", "--old"])
    following = argv[1:3] == ["events", "--next"] and watched_units(argv[3:]) is not None
    waits = len(argv) >= 2 and argv[1] == "wait-on"
    if not (len(argv) == 2 and argv[1] in commands or hidden or watcher or following
            or waits) or not jig_units.PROJECT.fullmatch(argv[0]):
        print("\n\n".join(__doc__.strip().split("\n\n")[1:3]), file=sys.stderr)
        return USAGE
    if watcher:
        # The watcher reads only the event file, so it needs no conf file and takes no
        # lock: it runs in the session beside the loop.
        return watch_events(argv[0], len(argv) == 3)
    if following:
        return watch_next(argv[0], watched_units(argv[3:]))
    try:
        activity = setting("JIG_ORCH_ACTIVITY", ACTIVITY_SECONDS)
        if waits:
            # The waits file needs no conf file and no lock, as the watcher.
            try:
                return wait_on(argv[0], argv[2:], activity)
            except OSError as error:
                print(f"jig orch: refused: wait-on: cannot write {error.filename}: "
                      f"{error.strerror}", file=sys.stderr)
                return REFUSED
        stall_override = setting("JIG_ORCH_STALL_SECONDS", None)
        poll = setting("JIG_ORCH_POLL", POLL_SECONDS)
        report_poll = setting("JIG_ORCH_REPORT_POLL", REPORT_POLL_SECONDS)
        hourly = setting("JIG_ORCH_HOURLY", HOURLY_SECONDS)
        fork_window = setting("JIG_ORCH_FORK_WINDOW", FORK_WINDOW_SECONDS)
        orch = Orch(argv[0])
        orch.fork_window = fork_window
        if hidden:
            # The descriptor holds the lock that start took; it stays open while this runs.
            descriptor = int(argv[2])
            os.ftruncate(descriptor, 0)
            os.pwrite(descriptor, f"{os.getpid()}\n".encode(), 0)
            return orch.loop(poll, report_poll, hourly, fork_window, activity,
                             stall_override)
        if argv[1] == "status":
            return orch.status(activity)
        return getattr(orch, argv[1])()
    except jig_units.Refused as error:
        print(f"jig orch: {error}", file=sys.stderr)
        return REFUSED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
