#!/usr/bin/env python3
"""Wait for a running unit with no model, and end on the first of these, each with its code.

usage: jig wait <project> <ID>

  0  the report commit, "log: <ID>", is on origin/<BRANCH> after the unit's last start
  3  a dialog: the session's normal input bar is missing for 2 polls in a row
  4  the timeout: 3x the expected time has passed since the session started
  5  no change: the screen at a check is the screen at the last check
  6  the tmux session ended, and the report commit is not on origin
  7  the worker account could not be reached by ssh for 3 polls in a row
  1  a refusal: no conf file, or no lock names a session of <ID>
  2  a usage error

The lock that jig start took names the session, its account and its start; the file
beside it holds the expected minutes. A check comes every JIG_WAIT_CHECK seconds (600)
and a poll every JIG_WAIT_POLL seconds (30). The first check compares with the screen
at the start of this wait. What is kept between checks is a hash of the screen without
the parts that change by themselves, never its text. On a dialog and on no change the
screen goes to stdout, except for a session in the spec writer's account: its screen can
show reference text, so only the end line and a line naming tmux attach are printed.

That exception holds only while the project's clean room is on: the clean room is the
setting that keeps reference material away from everyone but the spec writer. The
project profile in the kickoff record sets it (see lib/jig_profile.py). With "clean
room: off" the spec writer's screen is printed like any other. When the profile gives
no value, a line on stderr says so and the screen stays hidden, as with the clean room on.
"""

import hashlib
import os
import pathlib
import re
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

import jig_profile  # noqa: E402
import jig_units  # noqa: E402
from jig_tmux import DIALOG_POLLS, INPUT_BARS, has_input_bar, non_blank  # noqa: E402

REPORT, REFUSED, USAGE, DIALOG, TIMEOUT, NO_CHANGE, ENDED, UNREACHABLE = 0, 1, 2, 3, 4, 5, 6, 7

TIMEOUT_FACTOR = 3
POLL_SECONDS = 30.0
CHECK_SECONDS = 600.0
# The dialog test (the input bar is missing) is in lib/jig_tmux.py, shared with jig orch.
UNREACHABLE_POLLS = 3
SCREEN_LINES = 30
SCREEN_WIDTH = 200

# What moves by itself: spinner lines, a running count, the status lines, digits.
MOVING_LINE = re.compile("|".join([r"…", r" run [0-9]", *map(re.escape, INPUT_BARS)]))
DIGITS = re.compile(r"[0-9]")


def setting(name, default):
    text = os.environ.get(name)
    if not text:
        return default
    try:
        value = float(text)
    except ValueError:
        value = 0.0
    if value <= 0:
        raise jig_units.Refused(f"refused: setting: {name} must be a positive number of "
                                f"seconds, not {text}")
    return value


def screen_hash(screen):
    kept = [DIGITS.sub("", line).rstrip() for line in screen.splitlines()
            if not MOVING_LINE.search(line)]
    return hashlib.sha256("\n".join(kept).encode("utf-8")).hexdigest()


def report_landed(conf, unit):
    """Say whether "log: <ID>" is on origin/<BRANCH>, newer than the unit's last start."""
    clone, branch = conf["REPO"], conf["BRANCH"]
    jig_units.worker.git(clone, "fetch", "-q", "origin", branch)
    subjects = jig_units.worker.git_out(clone, "log", "--format=%s",
                                        f"refs/remotes/origin/{branch}", "--")
    for subject in subjects.splitlines():
        if subject == f"log: {unit}":
            return True
        if subject == f"status: {unit} start":
            return False
    return False


def capture(running):
    """Return the session's state, live, ended or unreachable, and its screen."""
    code, out, _ = jig_units.run_remote(
        running.account, ["tmux", "capture-pane", "-p", "-t", f"={running.session}:"])
    if code == 0:
        return "live", out
    return ("unreachable" if code == 255 else "ended"), ""


class Wait:
    def __init__(self, conf, running):
        self.conf = conf
        self.running = running
        # True when the screen must not be printed: a session in the spec account while
        # the clean room is on. The profile is read only for that account.
        self.spec = (jig_units.is_spec_account(conf, running.account)
                     and jig_profile.clean_room_on(conf))
        self.began = time.monotonic()

    def end(self, code, word, screen=None):
        unit = self.running.unit
        print(f"jig wait: {unit}: {word} after {round(time.monotonic() - self.began)}s "
              f"(exit {code})")
        if screen is not None:
            if self.spec:
                print(f"jig wait: no screen for the {self.running.account} account; "
                      f"to see it: tmux attach -t {self.running.session}, "
                      f"as {self.running.account}")
            else:
                for line in non_blank(screen)[-SCREEN_LINES:]:
                    print(line[:SCREEN_WIDTH])
        sys.stdout.flush()
        return code

    def run(self, poll, check):
        running = self.running
        deadline = running.start.timestamp() + TIMEOUT_FACTOR * running.expected * 60
        last = None
        next_check = self.began + check
        no_bar = unreachable = 0
        while True:
            if report_landed(self.conf, running.unit):
                return self.end(REPORT, "the report commit is on origin")
            state, screen = capture(running)
            if state == "unreachable":
                unreachable += 1
                if unreachable >= UNREACHABLE_POLLS:
                    return self.end(UNREACHABLE, f"{running.account} cannot be reached by ssh")
            elif state == "ended":
                if report_landed(self.conf, running.unit):
                    return self.end(REPORT, "the report commit is on origin")
                return self.end(ENDED, f"session {running.session} ended with no report")
            else:
                unreachable = 0
                no_bar = 0 if has_input_bar(screen) else no_bar + 1
                if no_bar >= DIALOG_POLLS:
                    return self.end(DIALOG, f"a dialog in session {running.session}", screen)
                digest = screen_hash(screen)
                if last is None:
                    last = digest
                elif time.monotonic() >= next_check:
                    if digest == last:
                        return self.end(NO_CHANGE, f"no change in session {running.session} "
                                                   f"since the last check", screen)
                    last = digest
                    next_check = time.monotonic() + check
                    print(f"jig wait: {running.unit}: check ok after "
                          f"{round(time.monotonic() - self.began)}s", flush=True)
            if time.time() >= deadline:
                return self.end(TIMEOUT, f"timeout: {TIMEOUT_FACTOR}x {running.expected} "
                                         f"minutes since the start at {running.start.isoformat()}")
            time.sleep(poll)


def find_unit(project, unit):
    found = [running for running in jig_units.running_units(project) if running.unit == unit]
    if len(found) > 1:
        jig_units.refuse("lock", f"more than one lock names a session of {unit}")
    return found[0] if found else None


def main(argv):
    if len(argv) != 2 or not jig_units.PROJECT.fullmatch(argv[0]) \
            or not jig_units.UNIT_ID.fullmatch(argv[1]):
        # The usage line and the exit codes, as the docstring gives them.
        print("\n\n".join(__doc__.strip().split("\n\n")[1:3]), file=sys.stderr)
        return USAGE
    project, unit = argv
    try:
        poll = setting("JIG_WAIT_POLL", POLL_SECONDS)
        check = setting("JIG_WAIT_CHECK", CHECK_SECONDS)
        conf = jig_units.read_conf(project)
        running = find_unit(project, unit)
        if running is None:
            if report_landed(conf, unit):
                print(f"jig wait: {unit}: the report commit is on origin (exit {REPORT})")
                return REPORT
            jig_units.refuse("lock", f"no lock in {jig_units.lock_dir()} names a session "
                                     f"of {unit} in {project}")
        if running.start is None or running.expected is None:
            jig_units.refuse("lock", f"the lock of {running.session} has no start or no "
                                     f"expected minutes")
    except jig_units.Refused as error:
        print(f"jig wait: {error}", file=sys.stderr)
        return REFUSED
    return Wait(conf, running).run(poll, check)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
