#!/usr/bin/env python3
"""Wait for a running unit with no model, and end on the first of these, each with its code.

usage: jig wait <project> <ID> [--expected <minutes>]

  0  the report commit, "log: <ID>", is on origin/<BRANCH> after the unit's last start
  3  a dialog: the session's normal input bar is missing for 2 polls in a row
  4  the timeout: 3x the expected time has passed since the session started
  5  no change: the screen at a check is the screen at the last check
  6  the tmux session ended, and the report commit is not on origin
  7  the worker account could not be reached by ssh for 3 polls in a row
  8  unpushed: at a check with no change, the session waits at its input bar with no
     running turn, and its -dev clone or product clone has a commit on its branch that
     the upstream of that branch does not have
  1  a refusal: no conf file, or no lock names a session of <ID>
  2  a usage error

The lock that jig start took names the session, its account and its start; the file
beside it holds the expected minutes. With --expected, jig wait first puts <minutes>,
a whole number above 0, in that file in the place of the old value, then waits as
without it; with no lock for <ID> it refuses and writes nothing, even when the report
is already on origin. Each poll reads the file again, so a new value from another jig
wait holds for every wait that already runs; a file that holds no valid value keeps
the last one. The timeout is always 3x the expected time since the session started,
so a new wait never restarts it. A check comes every JIG_WAIT_CHECK seconds (600)
and a poll every JIG_WAIT_POLL seconds (30). The first check compares with the screen
at the start of this wait. What is kept between checks is a hash of the screen without
the parts that change by themselves, never its text. On a dialog and on no change the
screen goes to stdout, except for a session in the spec writer's account: its screen can
show reference text, so only the end line and a line naming tmux attach are printed.

The end with code 8 is for a unit that stopped before its last push: it would
otherwise sit at its prompt, with a screen that never changes, until the timeout. A
screen with no change alone does not show it, because a long test run shows that
too, and the input bar alone does not, because the bar stays while a turn runs; so
the screen as it is must also show no running turn (the test of lib/jig_tmux.py).
The two clones, ~/ws/src/<project>-dev and ~/ws/src/<project> of the worker account,
are read through ssh, as the screen is; a clone that is missing or has no upstream
counts as pushed. The screen is printed as for code 5.

At each poll of a live session, jig wait also reads the unit's context readout in the
worker account, as jig ctx <tmux session> reads it there, with the limits of jig ctx:
200000 and 230000 tokens, or JIG_CTX_SOFT and JIG_CTX_HARD. The first reading at or
above the soft limit sends the unit a line, as jig send does, to start no new step; the
first at or above the hard limit sends a line to stop after its last pushed commit; a
first reading at both sends only the second. This is the fallback of the unit's own run
of jig ctx after each step. Each line goes at most once for each start of the unit, also
with two waits at once: the file <lock>.ctx beside the lock names the start and each
line sent, and is written before the send. Each line sent, or refused, is one line
"ctx: ..." in ~/ws/reviews/<project>/orch/events.log. No reading, or no ssh, sends
nothing; the lines never end the wait or change its exit code.

That exception holds only while the project's clean room is on: the clean room is the
setting that keeps reference material away from everyone but the spec writer. The
project profile in the kickoff record sets it (see lib/jig_profile.py). With "clean
room: off" the spec writer's screen is printed like any other. When the profile gives
no value, a line on stderr says so and the screen stays hidden, as with the clean room on.
"""

import datetime
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import os
import pathlib
import re
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import jig_context  # noqa: E402
import jig_profile  # noqa: E402
import jig_units  # noqa: E402
from jig_tmux import (DIALOG_POLLS, INPUT_BARS, has_input_bar, non_blank,  # noqa: E402
                      running_turn)

(REPORT, REFUSED, USAGE, DIALOG, TIMEOUT, NO_CHANGE, ENDED, UNREACHABLE,
 UNPUSHED) = 0, 1, 2, 3, 4, 5, 6, 7, 8

TIMEOUT_FACTOR = 3
POLL_SECONDS = 30.0
CHECK_SECONDS = 600.0
# The dialog test (the input bar is missing) is in lib/jig_tmux.py, shared with jig orch.
UNREACHABLE_POLLS = 3
SCREEN_LINES = 30
SCREEN_WIDTH = 200

# What moves by itself: spinner lines, a running count, the status lines, digits.
MOVING_LINE = re.compile("|".join([r"…", r" run [0-9]", *map(re.escape, INPUT_BARS)]))
DIGITS = re.compile(r"[0-9]")
WHOLE_MINUTES = re.compile(r"[0-9]+")

# The context readout is read in the unit's account by the code of lib/jig_context.py,
# sent there on stdin; a line is sent to the unit as jig send sends one.
CONTEXT_LIBRARY = ROOT / "lib" / "jig_context.py"
SEND_SCRIPT = ROOT / "libexec" / "jig-send"
READOUT = re.compile(r"(?P<tokens>[0-9]+)/[0-9]+")
EVENTS_FILE = "events.log"
CONTEXT_LINES = {
    "soft": "jig: your context is {tokens} tokens, at or above the soft limit of {limit}: "
            "start no new step; finish the step in hand, push it, and report STOPPED if "
            "steps are left.",
    "hard": "jig: your context is {tokens} tokens, at or above the hard limit of {limit}: "
            "stop after your last complete pushed commit, with a clean tree, and report "
            "STOPPED if steps are left.",
}


def setting(name, default):
    text = os.environ.get(name)
    if not text:
        return default
    try:
        value = float(text)
    except ValueError:
        value = 0.0
    if value <= 0:
        raise jig_units.Refused(f"refused: setting: {name} must be a positive number of "
                                f"seconds, not {text}")
    return value


def screen_hash(screen):
    kept = [DIGITS.sub("", line).rstrip() for line in screen.splitlines()
            if not MOVING_LINE.search(line)]
    return hashlib.sha256("\n".join(kept).encode("utf-8")).hexdigest()


def report_landed(conf, unit):
    """Say whether "log: <ID>" is on origin/<BRANCH>, newer than the unit's last start."""
    clone, branch = conf["REPO"], conf["BRANCH"]
    jig_units.worker.git(clone, "fetch", "-q", "origin", branch)
    subjects = jig_units.worker.git_out(clone, "log", "--format=%s",
                                        f"refs/remotes/origin/{branch}", "--")
    for subject in subjects.splitlines():
        if subject == f"log: {unit}":
            return True
        if subject == f"status: {unit} start":
            return False
    return False


def capture(running):
    """Return the session's state, live, ended or unreachable, and its screen."""
    code, out, _ = jig_units.run_remote(
        running.account, ["tmux", "capture-pane", "-p", "-t", f"={running.session}:"])
    if code == 0:
        return "live", out
    return ("unreachable" if code == 255 else "ended"), ""


def unpushed_clone(running):
    """Return the clone of the worker account, as a path from its home, whose branch
    has a commit that its upstream does not have, or None.

    ssh starts the command in the home of the account, so the paths are relative. git
    fails for a missing clone, a detached head or a branch with no upstream, and such a
    clone counts as pushed: only a commit that is known to be unpushed ends the wait.
    """
    for clone in (f"ws/src/{running.project}-dev", f"ws/src/{running.project}"):
        code, out, _ = jig_units.run_remote(
            running.account, ["git", "-C", clone, "rev-list", "--count", "@{upstream}..HEAD"])
        if code == 0 and out.strip().isdigit() and int(out.strip()) > 0:
            return clone
    return None


def context_tokens(running):
    """Return the tokens of the unit's context readout, or None for no reading.

    The readout is read in the worker account, as jig ctx <tmux session> reads it there:
    ssh starts python3, which runs lib/jig_context.py from stdin, so the worker account
    needs no access to this tree. A reading of none, an account that ssh does not reach
    and any other failure all give None, and so no line.
    """
    words = ["python3", "-I", "-", running.session]
    try:
        result = subprocess.run(jig_units.remote_command(running.account, words),
                                input=CONTEXT_LIBRARY.read_bytes(), capture_output=True,
                                timeout=jig_units.SSH_TIMEOUT_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    first = result.stdout.decode("utf-8", "replace").split("\n", 1)[0].strip()
    matched = READOUT.fullmatch(first)
    return int(matched["tokens"]) if matched else None


def mark_path(lock):
    return lock.with_name(lock.name + ".ctx")


def claim_line(running, kind):
    """Note in the mark beside the lock that the line of kind soft or hard goes to this
    start of the unit; return False when it went already, or must not go.

    The mark holds the start of the lock on its first line, then the kind of each line
    sent. A mark of another start is a mark of an earlier run of the unit and counts as
    none. Two jig waits can run on one unit, for example the one of jig batch and one of
    the orchestrator, so the mark is read and written under an exclusive lock of the
    file: of two waits that reach a limit at the same poll, only the first sends. A sent
    hard line also stands for the soft one, so the soft line never follows it.
    """
    start = f"start={running.start.isoformat()}"
    descriptor = os.open(mark_path(running.lock), os.O_RDWR | os.O_CREAT, 0o664)
    with os.fdopen(descriptor, "r+", encoding="utf-8") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        lines = stream.read().splitlines()
        sent = lines[1:] if lines[:1] == [start] else []
        if kind in sent or "hard" in sent:
            return False
        # Written before the send, so that a send that fails is not tried again.
        stream.seek(0)
        stream.truncate()
        stream.write("\n".join([start, *sent, kind]) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    return True


_sender = None


def send_line(running, text):
    """Send one line to the unit's session as jig send does; return None when it was
    submitted, or the reason of the refusal."""
    global _sender
    if _sender is None:
        loader = importlib.machinery.SourceFileLoader("jig_send", str(SEND_SCRIPT))
        _sender = importlib.util.module_from_spec(
            importlib.util.spec_from_loader("jig_send", loader))
        loader.exec_module(_sender)
    try:
        failure = _sender.run_worker(running.account, running.session, text, [])
    except OSError as error:
        return f"worker: {error.strerror or error}"
    return None if failure is None else f"{failure[0]}: {failure[1]}"


def announce(project, line):
    """Append one line to the orchestrator's event file, in one write in append mode, so
    that a line that jig batch or the supervisor appends at the same time is not mixed
    into it. A failure costs one line on stderr and does not end the wait."""
    path = pathlib.Path.home() / "ws" / "reviews" / project / "orch" / EVENTS_FILE
    data = f"{line}\n".encode("utf-8")
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            if os.write(descriptor, data) != len(data):
                raise OSError(0, "the line was written only in part")
        finally:
            os.close(descriptor)
    except OSError as error:
        print(f"jig wait: cannot append to {path} ({error.strerror or error}): {line}",
              file=sys.stderr, flush=True)


class Wait:
    def __init__(self, conf, running, limits=(jig_context.SOFT_LIMIT, jig_context.HARD_LIMIT)):
        self.conf = conf
        self.running = running
        # True when the screen must not be printed: a session in the spec account while
        # the clean room is on. The profile is read only for that account.
        self.spec = (jig_units.is_spec_account(conf, running.account)
                     and jig_profile.clean_room_on(conf))
        self.began = time.monotonic()
        self.soft, self.hard = limits
        # Once the hard line went to this start, no line can go any more, so the
        # readout is not read again.
        self.lines_done = False
        self.mark_failed = False

    def check_context(self):
        """Send the unit the soft or the hard line when its readout reached a limit and
        that line has not gone to this start yet, and note the send in the event file.

        This is the fallback of the unit's own run of jig ctx after each step. It never
        ends the wait and never changes its exit code.
        """
        if self.lines_done:
            return
        running = self.running
        tokens = context_tokens(running)
        if tokens is None or tokens < self.soft:
            return
        # A first reading at both limits sends only the hard line.
        kind = "hard" if tokens >= self.hard else "soft"
        limit = self.hard if kind == "hard" else self.soft
        try:
            claimed = claim_line(running, kind)
        except OSError as error:
            # With no mark the line could go at every poll, so it does not go at all.
            if not self.mark_failed:
                print(f"jig wait: {running.unit}: no {kind} line sent: cannot write the "
                      f"mark {mark_path(running.lock)}: {error.strerror or error}",
                      file=sys.stderr, flush=True)
            self.mark_failed = True
            return
        self.lines_done = kind == "hard"
        if not claimed:
            return
        failure = send_line(running, CONTEXT_LINES[kind].format(tokens=tokens, limit=limit))
        outcome = f"{kind} line sent" if failure is None else f"{kind} line not sent: {failure}"
        announce(running.project, f"ctx: {running.unit} {tokens} tokens, at or above "
                                  f"{limit}: {outcome}")

    def end(self, code, word, screen=None):
        unit = self.running.unit
        print(f"jig wait: {unit}: {word} after {round(time.monotonic() - self.began)}s "
              f"(exit {code})")
        if screen is not None:
            if self.spec:
                print(f"jig wait: no screen for the {self.running.account} account; "
                      f"to see it: tmux attach -t {self.running.session}, "
                      f"as {self.running.account}")
            else:
                for line in non_blank(screen)[-SCREEN_LINES:]:
                    print(line[:SCREEN_WIDTH])
        sys.stdout.flush()
        return code

    def run(self, poll, check):
        running = self.running
        last = None
        next_check = self.began + check
        no_bar = unreachable = 0
        while True:
            if report_landed(self.conf, running.unit):
                return self.end(REPORT, "the report commit is on origin")
            state, screen = capture(running)
            if state == "unreachable":
                unreachable += 1
                if unreachable >= UNREACHABLE_POLLS:
                    return self.end(UNREACHABLE, f"{running.account} cannot be reached by ssh")
            elif state == "ended":
                if report_landed(self.conf, running.unit):
                    return self.end(REPORT, "the report commit is on origin")
                return self.end(ENDED, f"session {running.session} ended with no report")
            else:
                unreachable = 0
                no_bar = 0 if has_input_bar(screen) else no_bar + 1
                if no_bar >= DIALOG_POLLS:
                    return self.end(DIALOG, f"a dialog in session {running.session}", screen)
                self.check_context()
                digest = screen_hash(screen)
                if last is None:
                    last = digest
                elif time.monotonic() >= next_check:
                    if digest == last:
                        # The running-turn test reads the screen as it is, with the
                        # spinner line that the hash leaves out.
                        clone = None
                        if has_input_bar(screen) and not running_turn(screen):
                            clone = unpushed_clone(running)
                        if clone:
                            return self.end(UNPUSHED, f"session {running.session} waits at "
                                                      f"its input prompt with a commit that "
                                                      f"is not pushed in ~/{clone}", screen)
                        return self.end(NO_CHANGE, f"no change in session {running.session} "
                                                   f"since the last check", screen)
                    last = digest
                    next_check = time.monotonic() + check
                    print(f"jig wait: {running.unit}: check ok after "
                          f"{round(time.monotonic() - self.began)}s", flush=True)
            # Another jig wait may have put a new value beside the lock since the last poll.
            running.expected = jig_units.read_expected(running.lock) or running.expected
            if time.time() >= deadline(running):
                return self.end(TIMEOUT, f"timeout: {TIMEOUT_FACTOR}x {running.expected} "
                                         f"minutes since the start at {running.start.isoformat()}")
            time.sleep(poll)


def deadline(running):
    return running.start.timestamp() + TIMEOUT_FACTOR * running.expected * 60


def parse(argv):
    """Return the project, the unit and the new expected minutes, or None for a usage
    error. The minutes are None when --expected is not given."""
    words, expected = list(argv), None
    if len(words) == 4 and words[2] == "--expected":
        if not WHOLE_MINUTES.fullmatch(words[3]) or int(words[3]) == 0:
            return None
        words, expected = words[:2], int(words[3])
    if len(words) != 2 or not jig_units.PROJECT.fullmatch(words[0]) \
            or not jig_units.UNIT_ID.fullmatch(words[1]):
        return None
    return words[0], words[1], expected


def find_unit(project, unit):
    found = [running for running in jig_units.running_units(project) if running.unit == unit]
    if len(found) > 1:
        jig_units.refuse("lock", f"more than one lock names a session of {unit}")
    return found[0] if found else None


def main(argv):
    parsed = parse(argv)
    if parsed is None:
        # The usage line and the exit codes, as the docstring gives them.
        print("\n\n".join(__doc__.strip().split("\n\n")[1:3]), file=sys.stderr)
        return USAGE
    project, unit, expected = parsed
    try:
        poll = setting("JIG_WAIT_POLL", POLL_SECONDS)
        check = setting("JIG_WAIT_CHECK", CHECK_SECONDS)
        try:
            limits = jig_context.limits()
        except ValueError as error:
            raise jig_units.Refused(f"refused: setting: {error}") from None
        conf = jig_units.read_conf(project)
        running = find_unit(project, unit)
        if running is None:
            # A new value for a unit with no lock goes nowhere, so it is refused even
            # when the report is already on origin: the caller learns that nothing changed.
            if expected is None and report_landed(conf, unit):
                print(f"jig wait: {unit}: the report commit is on origin (exit {REPORT})")
                return REPORT
            jig_units.refuse("lock", f"no lock in {jig_units.lock_dir()} names a session "
                                     f"of {unit} in {project}")
        if running.start is None or (expected is None and running.expected is None):
            jig_units.refuse("lock", f"the lock of {running.session} has no start or no "
                                     f"expected minutes")
        if expected is not None:
            try:
                jig_units.write_expected(running.lock, expected)
            except OSError as error:
                jig_units.refuse("expected", f"cannot write the expected minutes beside "
                                             f"{running.lock}: {error.strerror}")
            running.expected = expected
            ends = datetime.datetime.fromtimestamp(deadline(running)).astimezone()
            print(f"jig wait: {unit}: expected {expected} minutes; the timeout comes at "
                  f"{ends.isoformat(timespec='seconds')}", flush=True)
    except jig_units.Refused as error:
        print(f"jig wait: {error}", file=sys.stderr)
        return REFUSED
    return Wait(conf, running, limits).run(poll, check)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
