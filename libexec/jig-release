#!/usr/bin/env python3
"""Prepare, publish and verify a release of a project.

usage: jig release <project> prepare --entry <file> --trailer <line>
       jig release <project> publish [--dry-run]
       jig release <project> verify <version>

Runs as the implementer, inside the tmux session of the unit that makes the release,
because the checks that the implementer runs go through jig run-check, which records
their exit codes for that unit. The -dev clone is REPO of ~/.config/jig/<project>.conf,
the product clone is <REPO>/<project>, and the version line is BRANCH, of the form
<X>.<Y>. The version is <X>.<Y>.0 when the product has no tag v<X>.<Y>.<n> on the line,
else the newest such tag with its last number plus 1.

prepare runs these steps in order and prints the name of each. The first that fails
prints one line on stderr with the step and the reason, removes the staging directory,
and prepare exits 1, so that publish never finds a partial set of files.

  the change log entry and the release commit: the file that --entry names holds the
    prose of the entry, with the four parts "What changed:", "Files and formats:",
    "Migration:" and "Requested by:". prepare adds the heading "## <X.Y.Z>" and the
    line "Units: <n> minor, <n> patch, <n> none", counted from the "class:" lines of
    the unit reports since the last release, and puts the entry first in
    CHANGELOG.md, in place of an entry of the same version that an earlier attempt
    left. Then make version-bump VERSION=<X.Y.Z>, one commit "Release <X.Y.Z>" whose
    last line is the --trailer line, and git push origin <line>. The --trailer line
    is required, because the commit goes to a public line where it can never be
    rewritten, and every commit must carry its Co-Authored-By trailer. The product
    clone must be clean, on the line and equal to origin/<line>, and its pushes must
    go to a push URL of their own (tools/push-on-token.sh sets it). Every later
    step works on that commit.

    A rerun after a failed step reuses the release commit of the earlier run: when
    the clone's HEAD is the commit "Release <X.Y.Z>" and the entry and the bump leave
    its tree as it is, prepare makes no new commit and goes on with HEAD. The clone
    may then be one commit ahead of origin/<line>, by that commit, after a push that
    failed; prepare pushes it. So a stop after the push, or a refused push, needs no
    change before the rerun, and the line gets no second release commit. A rerun
    whose entry or unit counts differ makes a second commit "Release <X.Y.Z>" on top
    of the first.
  CI green on that commit: tools/ci-green --wait, with the seconds from
    JIG_RELEASE_CI_WAIT (1800 unless set) and the token file
    ~/.config/jig/<project>-token.
  the clean-clone proof: in a new clone of that commit, make check, make package
    package-check source-archive, and make in the unpacked source archive under
    unshare -rn, which leaves it no network. The commands in the clone run with
    LINT_TERMS=<REPO>/terms.txt, because the clone is not nested in the -dev clone,
    where lint A looks for the private terms by default, and a check without them
    fails. The offline build runs without LINT_TERMS, to prove that the archive
    builds without the private file. The files that package and source-archive
    wrote into dist/ are copied into the staging directory
    ~/ws/reviews/<project>/release/<X.Y.Z>/.
  the release files: README.md, LICENSE, THIRD-PARTY-NOTICES and SOURCE-OFFER are in
    the tree of that commit; package-check has already checked the package.
  private terms and privacy: jig terms check <project> <staging directory>, then jig
    terms check <project> <temporary directory>, which holds each staged tar archive
    unpacked into a directory of the archive's name, and jig privacy scan <project>
    all exit 0. jig terms check reads an archive as its compressed bytes, so a term
    in a file that only the package holds is found only in the unpacked copy.
  the rows of checks.tsv: a row of the implementer account runs through jig
    run-check and must exit 0. For a row of another account, the copy of its exit
    file, <JIG_SRV>/checks/<project>/<name>.exit with JIG_SRV /srv/jig unless set,
    must hold 0 on its first line, and on its second a -dev commit that is
    origin/<line> after a fetch, or an ancestor of it, with no change outside impl/
    between the two: a later report or status line does not undo the result.
  SHA256SUMS of the staged files, written last, so that its presence marks a
    complete set.

The unit reports since the last release are the files impl/log/<ID>-report.md added in
the -dev commits after the tag v<X.Y.Z> of the previous release; when the line has no
release yet, those added in the commits of origin/<line> that origin/master does not
hold. The output of the commands goes to ~/ws/reviews/<project>/release/<X.Y.Z>-prepare.txt.

publish puts the staged release on GitHub. It runs four checks, and then the actions;
each prints its name, and the first that fails prints one line on stderr with the step
and the reason, and publish exits 1.

  the staged release: after a fetch of both clones, the version is the one prepare
    gave the line, counted from the v tags of the line that do not point at its head,
    so that a rerun after the tag finds the same version. Its staging directory must
    exist.
  SHA256SUMS of the staged files: it lists every staged file, and each hash matches.
  the release commit: the head of origin/<line> of the product is the commit "Release
    <X.Y.Z>", its VERSION reads <X.Y.Z>, and the top entry of its CHANGELOG.md is
    "## <X.Y.Z>". The product clone has a push URL of its own. The -dev commit is the
    head of origin/<line> of the -dev clone.
  the merge to master can fast-forward: in each repo, master on origin is an ancestor
    of the line's commit, so that no action runs when the merge would be refused.
  the actions: the annotated tag v<X.Y.Z> at the release commit in the product and at
    the -dev commit in -dev; the GitHub release of that tag with the staged files and
    SHA256SUMS; the readback of the release by tag and of each file from its download
    URL, with no login, compared with the staged files by name and hash; and the push
    of the line's commit to master in the product and then in -dev, which git refuses
    unless it is a fast-forward, each followed by the merge check: after a new fetch,
    the tree of master equals the tree of the line's commit.

A rerun after a publish that stopped partway is safe: an action whose result exists
already and matches passes without acting, and one whose result differs fails. A tag
must point at the same commit; in -dev it may also point at an earlier head of the
line, because status and report commits land there between two runs. A release file
must have the staged hash, and the release must hold no other file. Nothing is ever
deleted or forced. With --dry-run publish runs the checks, prints what each action
would do, and changes nothing on GitHub or on either origin.

The product pushes go to the product clone's push URL, which tools/push-on-token.sh
points at the token; the -dev pushes go to the -dev clone's origin, on its deploy key.
publish changes no git config of either clone. The GitHub calls that write use the
token file ~/.config/jig/<project>-token. The API base is JIG_GITHUB_API
(https://api.github.com unless set) and the web base is JIG_GITHUB_WEB
(https://github.com unless set); owner and repo come from the product's origin URL.

verify <version> checks, with no login, that the published files equal the staged files
by hash, that the tag v<version> on the product's origin points at the release commit of
that version (its subject, VERSION and top change log entry, as above), that the repo is
public, and that the status badge of the workflow ci.yml on master reads passing.

Every command exits 0 when every step passes, 1 when one fails, 2 on a usage error.
"""

import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request

sys.dont_write_bytecode = True
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import jig_units  # noqa: E402

USAGE = ("usage: jig release <project> prepare --entry <file> --trailer <line>\n"
         "       jig release <project> publish [--dry-run]\n"
         "       jig release <project> verify <version>")
LINE_FORM = re.compile(r"[0-9]+\.[0-9]+")
FULL_COMMIT = re.compile(r"[0-9a-f]{40}")
REPORT_PATH = re.compile(r"impl/log/[^/]+-report\.md")
CLASS_LINE = re.compile(r"class:\s*(\S+)\s*")
ENTRY_PARTS = ("What changed:", "Files and formats:", "Migration:", "Requested by:")
RELEASE_FILES = ("README.md", "LICENSE", "THIRD-PARTY-NOTICES", "SOURCE-OFFER")
SUMS = "SHA256SUMS"
DEFAULT_CI_WAIT = 1800
SRV_ROOT = "/srv/jig"
DEFAULT_IMPL_ACCOUNT = "implementer"
GITHUB_API = "https://api.github.com"
GITHUB_WEB = "https://github.com"
VERSION_FORM = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
SUMS_LINE = re.compile(r"([0-9a-f]{64})  ([^/\s][^/]*)")
ORIGIN_SLUG = re.compile(r"[:/]([^/:]+/[^/:]+?)(?:\.git)?/?$")
HTTP_TIMEOUT = 60
STEPS = (
    "the change log entry and the release commit",
    "CI green on the release commit",
    "the clean-clone proof",
    "the release files",
    "private terms and privacy",
    "the rows of checks.tsv",
    "SHA256SUMS",
)


class StepFailed(Exception):
    """The current step cannot pass; the message is the reason."""


def git(clone, *args):
    return subprocess.run(["git", "-C", str(clone), *args], capture_output=True, text=True,
                          stdin=subprocess.DEVNULL, check=False)


def git_out(clone, *args):
    """Return git's output, or fail the step with git's own last line."""
    result = git(clone, *args)
    if result.returncode != 0:
        raise StepFailed(f"git {' '.join(args)} in {clone}: {last_line(result.stderr)}")
    return result.stdout.strip()


def last_line(text):
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    return lines[-1] if lines else "no output"


def entry_problem(text):
    """Return why the prose of a change log entry cannot be used, or None."""
    lines = text.splitlines()
    for part in ENTRY_PARTS:
        if not any(line.startswith(part) for line in lines):
            return f"the entry file has no part {part!r}"
    # prepare writes the heading itself; one in the prose would split the entry in two.
    if any(line.startswith("## ") for line in lines):
        return "the entry file holds a heading '## ', which prepare writes itself"
    return None


def next_version(product, line):
    """Return the version to release and the newest release tag of the line, or None."""
    form = re.compile(rf"v{re.escape(line)}\.([0-9]+)")
    numbers = [int(match.group(1))
               for tag in git_out(product, "tag", "--merged", "HEAD", "--list",
                                  f"v{line}.*").splitlines()
               if (match := form.fullmatch(tag.strip()))]
    if not numbers:
        return f"{line}.0", None
    newest = max(numbers)
    return f"{line}.{newest + 1}", f"v{line}.{newest}"


def report_range(dev, line, previous_tag):
    """Return the -dev commits whose reports count toward this release, as git log takes them."""
    head = f"refs/remotes/origin/{line}"
    if previous_tag:
        if git(dev, "rev-parse", "-q", "--verify", f"refs/tags/{previous_tag}^{{commit}}") \
                .returncode != 0:
            raise StepFailed(f"the -dev clone has no tag {previous_tag} of the previous release")
        return [f"refs/tags/{previous_tag}..{head}"]
    if git(dev, "rev-parse", "-q", "--verify", "refs/remotes/origin/master").returncode == 0:
        return [head, "^refs/remotes/origin/master"]
    return [head]


def count_classes(dev, line, previous_tag):
    """Count the change classes of the unit reports added since the previous release."""
    added = git_out(dev, "log", "--format=", "--name-only", "--diff-filter=A",
                    *report_range(dev, line, previous_tag), "--", "impl/log/")
    counts = {}
    for path in sorted(set(added.split())):
        if not REPORT_PATH.fullmatch(path):
            continue
        shown = git(dev, "show", f"refs/remotes/origin/{line}:{path}")
        if shown.returncode != 0:
            continue
        # The class belongs to the header, which ends at the first "---".
        for text in shown.stdout.split("\n---", 1)[0].splitlines():
            match = CLASS_LINE.fullmatch(text)
            if match:
                counts[match.group(1)] = counts.get(match.group(1), 0) + 1
                break
    return counts


def units_line(counts):
    words = [f"{counts.get(name, 0)} {name}" for name in ("minor", "patch", "none")]
    # A major change is rare, and the line names it only when there is one.
    if counts.get("major"):
        words.insert(0, f"{counts['major']} major")
    return "Units: " + ", ".join(words)


def with_entry(changelog, version, entry):
    """Return the change log with this entry first, and no other entry of its version."""
    lines = changelog.splitlines(keepends=True)
    kept, skipping = [], False
    for text in lines:
        if text.startswith("## "):
            skipping = text.split()[1:2] == [version]
        if not skipping:
            kept.append(text)
    for index, text in enumerate(kept):
        if text.startswith("## "):
            return "".join(kept[:index]) + entry + "\n" + "".join(kept[index:])
    head = "".join(kept)
    if head and not head.endswith("\n\n"):
        head = head.rstrip("\n") + "\n\n"
    return head + entry


def copy_problem(path, dev, line):
    """Return why the copy of another account's exit file does not stand, or None.

    The -dev clone is fetched first, so that a run on a commit pushed from another
    account is found.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return f"no copy of its exit file at {path}"
    except (OSError, UnicodeDecodeError) as error:
        return f"cannot read {path}: {getattr(error, 'strerror', None) or error}"
    code = lines[0].strip() if lines else ""
    if code != "0":
        return f"{path} holds the exit code {code or 'nothing'}"
    commit = lines[1].strip() if len(lines) > 1 else ""
    if not FULL_COMMIT.fullmatch(commit):
        return f"the second line of {path} is not a commit"
    fetched = git(dev, "fetch", "-q", "origin")
    if fetched.returncode != 0:
        return f"cannot fetch the -dev clone: {last_line(fetched.stderr)}"
    head = f"refs/remotes/origin/{line}"
    if git(dev, "cat-file", "-e", f"{commit}^{{commit}}").returncode != 0:
        return f"{path} names {commit}, which is not a commit of the -dev repo"
    if git(dev, "merge-base", "--is-ancestor", commit, head).returncode != 0:
        return f"{path} names {commit}, which is not on origin/{line} of the -dev repo"
    changed = git(dev, "diff", "--name-only", commit, head)
    if changed.returncode != 0:
        return f"cannot compare {commit} with origin/{line}: {last_line(changed.stderr)}"
    outside = [name for name in changed.stdout.splitlines() if not name.startswith("impl/")]
    if outside:
        return (f"the -dev repo changed outside impl/ after {commit}, "
                f"in {outside[0]} and {len(outside) - 1} more")
    return None


def read_rows(dev):
    path = pathlib.Path(dev) / "checks.tsv"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise StepFailed(f"cannot read {path}: {error.strerror}") from None
    rows = []
    for text in lines[1:]:
        if not text.strip():
            continue
        fields = text.split("\t")
        if len(fields) != 4:
            raise StepFailed(f"a row of {path} is not name, command, account, cap: {text}")
        rows.append((fields[0], fields[2]))
    return rows


def sums_text(directory):
    lines = []
    for path in sorted(directory.iterdir()):
        if path.name == SUMS or not path.is_file():
            continue
        digest = hashlib.sha256()
        with open(path, "rb") as stream:
            for block in iter(lambda: stream.read(1 << 20), b""):
                digest.update(block)
        lines.append(f"{digest.hexdigest()}  {path.name}\n")
    return "".join(lines)


class Prepare:
    def __init__(self, project, entry_file, trailer):
        self.project = project
        self.entry_file = entry_file
        self.trailer = trailer
        conf = jig_units.read_conf(project)
        self.dev = pathlib.Path(conf["REPO"])
        self.product = self.dev / project
        self.line = conf["BRANCH"]
        self.impl_account = conf.get("IMPL_ACCOUNT") or DEFAULT_IMPL_ACCOUNT
        self.releases = pathlib.Path(os.path.expanduser(f"~/ws/reviews/{project}/release"))
        self.version = None
        self.staging = None
        self.log = None
        self.commit = None

    def logged(self, command, cwd, capture=False, env=None):
        """Run a command with its output in the log; return the code, and the text if asked.

        env replaces the environment of the command when it is given.
        """
        with open(self.log, "a", encoding="utf-8") as stream:
            stream.write(f"$ {' '.join(map(str, command))}  (in {cwd})\n")
            stream.flush()
            try:
                result = subprocess.run([str(part) for part in command], cwd=cwd, env=env,
                                        stdin=subprocess.DEVNULL, check=False, text=True,
                                        stdout=subprocess.PIPE if capture else stream,
                                        stderr=subprocess.STDOUT)
            except OSError as error:
                raise StepFailed(f"cannot run {command[0]}: {error.strerror}") from None
            if capture:
                stream.write(result.stdout)
        return result.returncode, (result.stdout if capture else "")

    def make(self, cwd, *targets, wrapper=(), env=None):
        code, _ = self.logged([*wrapper, "make", *targets], cwd, env=env)
        if code != 0:
            raise StepFailed(f"{' '.join([*wrapper, 'make', *targets])} exited {code} "
                             f"in {cwd}; output in {self.log}")

    def run(self):
        steps = (self.release_commit, self.ci_green, self.clean_clone, self.release_files,
                 self.terms_and_privacy, self.rows, self.sums)
        for number, (name, step) in enumerate(zip(STEPS, steps), 1):
            print(f"jig release: prepare {number}/{len(STEPS)}: {name}", flush=True)
            try:
                step()
            except (StepFailed, OSError) as error:
                # A disk error is a failed step too: it gets the same one line, and the
                # same removal of the partial staging directory, not a traceback.
                if isinstance(error, OSError):
                    error = f"{error.filename or 'a file'}: {error.strerror or error}"
                if self.staging is not None:
                    shutil.rmtree(self.staging, ignore_errors=True)
                print(f"jig release: prepare failed at {name}: {error}", file=sys.stderr)
                return 1
        print(f"jig release: {self.project} {self.version} is prepared: {self.commit}, "
              f"files in {self.staging}")
        return 0

    def release_commit(self):
        try:
            prose = pathlib.Path(self.entry_file).read_text(encoding="utf-8").strip()
        except (OSError, UnicodeDecodeError) as error:
            raise StepFailed(f"cannot read the entry file {self.entry_file}: "
                             f"{getattr(error, 'strerror', None) or error}") from None
        problem = entry_problem(prose)
        if problem:
            raise StepFailed(problem)
        if not LINE_FORM.fullmatch(self.line):
            raise StepFailed(f"the line {self.line} is not of the form <X>.<Y>")
        if not (self.product / ".git").exists():
            raise StepFailed(f"no product clone at {self.product}")
        if not git(self.product, "config", "--get", "remote.origin.pushurl").stdout.strip():
            raise StepFailed(f"remote.origin.pushurl of {self.product} is not set; "
                             f"tools/push-on-token.sh sets it")
        git_out(self.product, "fetch", "-q", "--tags", "origin")
        git_out(self.dev, "fetch", "-q", "--tags", "origin")
        branch = git(self.product, "symbolic-ref", "-q", "--short", "HEAD").stdout.strip()
        if branch != self.line:
            raise StepFailed(f"the product clone is on {branch or 'no branch'}, "
                             f"not on {self.line}")
        if git_out(self.product, "status", "--porcelain"):
            raise StepFailed("the product clone has changes that are not committed")

        self.version, previous_tag = next_version(self.product, self.line)
        if git(self.product, "rev-parse", "-q", "--verify",
               f"refs/tags/v{self.version}").returncode == 0:
            raise StepFailed(f"the tag v{self.version} exists already")
        subject = f"Release {self.version}"
        head = git_out(self.product, "rev-parse", "HEAD")
        line_head = git_out(self.product, "rev-parse", f"refs/remotes/origin/{self.line}")
        # The one commit the clone may hold beyond origin is the release commit of an
        # earlier run whose push failed; the rerun pushes it.
        if head != line_head and not (
                git_out(self.product, "log", "-1", "--format=%s", head) == subject
                and git(self.product, "rev-parse", "-q", "--verify", f"{head}^").stdout.strip()
                == line_head):
            raise StepFailed(f"the product clone is not at origin/{self.line}")
        counts = count_classes(self.dev, self.line, previous_tag)

        # An earlier attempt at this version may have left staged files; they do not
        # belong to the commit made now.
        self.releases.mkdir(parents=True, exist_ok=True)
        self.staging = self.releases / self.version
        shutil.rmtree(self.staging, ignore_errors=True)
        self.log = self.releases / f"{self.version}-prepare.txt"
        self.log.write_text(f"jig release {self.project} prepare {self.version}\n",
                            encoding="utf-8")
        print(f"jig release: version {self.version}; output in {self.log}", flush=True)

        changelog = self.product / "CHANGELOG.md"
        try:
            old = changelog.read_text(encoding="utf-8") if changelog.exists() else ""
            entry = f"## {self.version}\n\n{prose}\n\n{units_line(counts)}\n"
            changelog.write_text(with_entry(old, self.version, entry), encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            raise StepFailed(f"cannot write {changelog}: "
                             f"{getattr(error, 'strerror', None) or error}") from None
        try:
            self.make(self.product, "version-bump", f"VERSION={self.version}")
            git_out(self.product, "add", "-A")
            # An earlier run of this version made the same commit already: a second
            # one would put two release commits on the line, and an empty commit
            # fails, so the rerun goes on with HEAD.
            reused = not git_out(self.product, "status", "--porcelain") and \
                git_out(self.product, "log", "-1", "--format=%s", "HEAD") == subject
            if not reused:
                git_out(self.product, "commit", "-q", "-m",
                        f"{subject}\n\n{self.trailer}\n")
        except StepFailed:
            # The clone was clean before, so this removes only what prepare wrote.
            git(self.product, "reset", "-q", "--hard", "HEAD")
            git(self.product, "clean", "-q", "-f", "-d")
            raise
        self.commit = git_out(self.product, "rev-parse", "HEAD")
        if reused:
            print(f"jig release: the entry and the version are already in {self.commit}, "
                  f"which this run reuses", flush=True)
        if self.commit == line_head:
            print(f"jig release: release commit {self.commit} is on origin already",
                  flush=True)
            return
        code, output = self.logged(["git", "push", "origin", self.line], self.product,
                                   capture=True)
        if code != 0:
            raise StepFailed(f"git push origin {self.line} failed: {last_line(output)}; "
                             f"the release commit {self.commit} is only in the clone, "
                             f"and a rerun of prepare pushes it")
        print(f"jig release: release commit {self.commit} pushed", flush=True)

    def ci_green(self):
        text = os.environ.get("JIG_RELEASE_CI_WAIT") or str(DEFAULT_CI_WAIT)
        if not text.isdigit():
            raise StepFailed(f"JIG_RELEASE_CI_WAIT is not a number of seconds: {text}")
        token = pathlib.Path(os.path.expanduser(f"~/.config/jig/{self.project}-token"))
        code, output = self.logged([ROOT / "tools" / "ci-green", "--wait", text, self.product,
                                    token, self.commit], self.product, capture=True)
        if code != 0:
            raise StepFailed(f"ci-green exited {code}: {last_line(output)}")

    def clean_clone(self):
        work = pathlib.Path(tempfile.mkdtemp(prefix="jig-release."))
        try:
            clone = work / "clone"
            code, output = self.logged(["git", "clone", "-q", "--no-hardlinks", self.product,
                                        clone], work, capture=True)
            if code != 0:
                raise StepFailed(f"git clone failed: {last_line(output)}")
            git_out(clone, "checkout", "-q", "--detach", self.commit)
            # Lint A of a clone looks for the private terms beside it, as in the -dev
            # clone, and fails without them; this clone stands alone in /tmp.
            terms = dict(os.environ, LINT_TERMS=str(self.dev / "terms.txt"))
            self.make(clone, "check", env=terms)
            self.make(clone, "package", "package-check", env=terms)
            dist = clone / "dist"
            packaged = set(dist.iterdir()) if dist.is_dir() else set()
            self.make(clone, "source-archive", env=terms)
            archives = [path for path in (set(dist.iterdir()) if dist.is_dir() else set())
                        - packaged if path.is_file()]
            if len(archives) != 1:
                raise StepFailed(f"make source-archive wrote {len(archives)} new files "
                                 f"into dist/, not one")
            self.staging.mkdir(parents=True, exist_ok=True)
            for path in sorted(dist.iterdir()):
                if path.is_file():
                    shutil.copy2(path, self.staging / path.name)
            self.offline_build(archives[0], work / "offline")
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def offline_build(self, archive, target):
        # Probe first, so that a refusal to make the namespace is told apart from a
        # build that fails without the network.
        code, output = self.logged(["unshare", "-rn", "true"], target.parent, capture=True)
        if code != 0:
            raise StepFailed(f"unshare is not allowed here, so no offline build: "
                             f"{last_line(output)}")
        try:
            with tarfile.open(archive) as tar:
                tar.extractall(target, filter="data")
        except (OSError, tarfile.TarError) as error:
            raise StepFailed(f"cannot unpack {archive.name}: {error}") from None
        entries = list(target.iterdir())
        build = entries[0] if len(entries) == 1 and entries[0].is_dir() else target
        # Whoever builds the published archive has no private terms file, so the
        # build must pass without one even when the caller's environment names it.
        bare = {key: value for key, value in os.environ.items() if key != "LINT_TERMS"}
        self.make(build, wrapper=("unshare", "-rn"), env=bare)

    def release_files(self):
        listed = {}
        for text in git_out(self.product, "ls-tree", self.commit).splitlines():
            info, name = text.split("\t", 1)
            listed[name] = info.split()[1]
        for name in RELEASE_FILES:
            if listed.get(name) != "blob":
                raise StepFailed(f"the release commit has no file {name}")

    def terms_and_privacy(self):
        self.tool("jig-terms", "check", self.project, self.staging)
        # jig terms check reads an archive as its compressed bytes, where no term can
        # be seen, so the files that only the package holds are read unpacked.
        unpacked = pathlib.Path(tempfile.mkdtemp(prefix="jig-release."))
        try:
            for path in sorted(self.staging.iterdir()):
                if path.is_file() and tarfile.is_tarfile(path):
                    try:
                        with tarfile.open(path) as tar:
                            tar.extractall(unpacked / path.name, filter="data")
                    except (OSError, tarfile.TarError) as error:
                        raise StepFailed(f"cannot unpack {path.name}: {error}") from None
            self.tool("jig-terms", "check", self.project, unpacked)
        finally:
            shutil.rmtree(unpacked, ignore_errors=True)
        self.tool("jig-privacy", "scan", self.project)

    def tool(self, name, command, *args):
        """Run one of jig's own commands from the -dev clone; fail the step unless it exits 0."""
        code, output = self.logged([ROOT / "libexec" / name, command, *args], self.dev,
                                   capture=True)
        if code != 0:
            raise StepFailed(f"{name.replace('-', ' ', 1)} {command} exited {code}: "
                             f"{output.splitlines()[0] if output.strip() else 'no output'}")

    def rows(self):
        rows = read_rows(self.dev)
        srv = pathlib.Path(os.environ.get("JIG_SRV") or SRV_ROOT)
        # The copies cost nothing to read, so a stale one stops the release before the
        # long rows run.
        for name, account in rows:
            if account != self.impl_account:
                problem = copy_problem(srv / "checks" / self.project / f"{name}.exit",
                                       self.dev, self.line)
                if problem:
                    raise StepFailed(f"the row {name} of the account {account}: {problem}")
        for name, account in rows:
            if account == self.impl_account:
                code, output = self.logged([ROOT / "libexec" / "jig-run-check", self.project,
                                            name], self.dev, capture=True)
                if code != 0:
                    raise StepFailed(f"the row {name} exited {code}: {last_line(output)}")

    def sums(self):
        partial = self.staging / f".{SUMS}.partial"
        partial.write_text(sums_text(self.staging), encoding="utf-8")
        partial.replace(self.staging / SUMS)


def file_hash(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def read_staged(staging):
    """Return {name: sha256} of the staged files and SHA256SUMS, after checking the sums."""
    sums = staging / SUMS
    if not sums.is_file():
        raise StepFailed(f"{staging} has no {SUMS}; prepare writes it last, so the set "
                         f"is not complete")
    listed = {}
    for text in sums.read_text(encoding="utf-8").splitlines():
        match = SUMS_LINE.fullmatch(text)
        if not match or match.group(2) in listed or match.group(2) == SUMS:
            raise StepFailed(f"{sums} has a line that is not '<sha256>  <file name>' "
                             f"of one other file: {text}")
        listed[match.group(2)] = match.group(1)
    present = {path.name for path in staging.iterdir() if path.name != SUMS}
    if not listed:
        raise StepFailed(f"{sums} lists no file")
    if present != set(listed):
        extra = sorted(present - set(listed))
        missing = sorted(set(listed) - present)
        raise StepFailed(f"{sums} does not match the staging directory: "
                         f"not listed {extra or 'none'}, missing {missing or 'none'}")
    for name, digest in sorted(listed.items()):
        path = staging / name
        if not path.is_file():
            raise StepFailed(f"{path} is not a file")
        if file_hash(path) != digest:
            raise StepFailed(f"{name} does not match its hash in {SUMS}")
    listed[SUMS] = file_hash(sums)
    return listed


def release_version(product, line, head):
    """Return the version whose release commit is the head of the line.

    It is the version prepare gave: <line>.0, or the newest v tag of the line plus 1.
    A tag at the head itself is this release's own tag from an earlier run, so it does
    not count.
    """
    form = re.compile(rf"v{re.escape(line)}\.([0-9]+)")
    own = set(git_out(product, "tag", "--points-at", head).split())
    numbers = [int(match.group(1))
               for tag in git_out(product, "tag", "--merged", head, "--list",
                                  f"v{line}.*").split()
               if tag not in own and (match := form.fullmatch(tag))]
    return f"{line}.{max(numbers) + 1}" if numbers else f"{line}.0"


def release_commit_problem(clone, commit, version):
    """Return why a commit is not the release commit of a version, or None."""
    subject = git_out(clone, "log", "-1", "--format=%s", commit)
    if subject != f"Release {version}":
        return f"{commit} is the commit {subject!r}, not 'Release {version}'"
    shown = git(clone, "show", f"{commit}:VERSION")
    if shown.returncode != 0:
        return f"{commit} has no file VERSION"
    if shown.stdout.strip() != version:
        return f"VERSION at {commit} reads {shown.stdout.strip()!r}, not {version}"
    shown = git(clone, "show", f"{commit}:CHANGELOG.md")
    headings = [line.rstrip() for line in shown.stdout.splitlines() if line.startswith("## ")]
    if shown.returncode != 0 or not headings:
        return f"CHANGELOG.md at {commit} has no entry"
    if headings[0] != f"## {version}":
        return f"the top entry of CHANGELOG.md at {commit} is {headings[0]!r}, not '## {version}'"
    return None


def top_entry(clone, commit):
    """Return the text under the first heading of the change log, for the release notes."""
    lines = git_out(clone, "show", f"{commit}:CHANGELOG.md").splitlines()
    starts = [number for number, line in enumerate(lines) if line.startswith("## ")]
    end = starts[1] if len(starts) > 1 else len(lines)
    return "\n".join(lines[starts[0] + 1:end]).strip() + "\n"


def remote_tag(clone, tag):
    """Return (object, commit) of a tag on origin; commit is None for a lightweight tag."""
    ref = f"refs/tags/{tag}"
    found = {}
    for text in git_out(clone, "ls-remote", "origin", ref, f"{ref}^{{}}").splitlines():
        sha, name = text.split("\t", 1)
        found[name] = sha
    return found.get(ref), found.get(f"{ref}^{{}}")


def origin_slug(clone):
    url = git_out(clone, "remote", "get-url", "origin")
    match = ORIGIN_SLUG.search(url)
    if not match:
        raise StepFailed(f"cannot read owner/repo from the origin of {clone}: {url}")
    return match.group(1)


def http(url, token=None, data=None, content_type=None, method=None):
    """Return the body of a request; with no token the request carries no login at all."""
    headers = {}
    if token is not None:
        headers = {"Accept": "application/vnd.github+json",
                   "Authorization": f"Bearer {token}",
                   "X-GitHub-Api-Version": "2022-11-28"}
    if content_type:
        headers["Content-Type"] = content_type
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            return response.read()
    except urllib.error.HTTPError as error:
        raise StepFailed(f"{method or 'GET'} {url}: HTTP {error.code}") from None
    except (urllib.error.URLError, OSError) as error:
        raise StepFailed(f"{method or 'GET'} {url}: {error}") from None


def http_json(url, **options):
    body = http(url, **options)
    try:
        return json.loads(body)
    except ValueError:
        raise StepFailed(f"{url} did not answer with JSON") from None


def missing_is_none(call):
    """Run an API read; a 404 means the thing does not exist yet, which is not a failure."""
    try:
        return call()
    except StepFailed as error:
        if str(error).endswith(": HTTP 404"):
            return None
        raise


def asset_names(release):
    try:
        return {asset["name"]: asset["browser_download_url"]
                for asset in release.get("assets") or []}
    except (KeyError, TypeError, AttributeError):
        raise StepFailed("the release's file list has no name or download URL") from None


class Published:
    """What publish and verify share: the clones, the line and the GitHub addresses."""

    command = None

    def __init__(self, project):
        self.project = project
        conf = jig_units.read_conf(project)
        self.dev = pathlib.Path(conf["REPO"])
        self.product = self.dev / project
        self.line = conf["BRANCH"]
        self.releases = pathlib.Path(os.path.expanduser(f"~/ws/reviews/{project}/release"))
        self.api = (os.environ.get("JIG_GITHUB_API") or GITHUB_API).rstrip("/")
        self.web = (os.environ.get("JIG_GITHUB_WEB") or GITHUB_WEB).rstrip("/")
        self.version = None
        self.staging = None
        self.staged = None
        self.commit = None

    @property
    def tag(self):
        return f"v{self.version}"

    def steps(self):
        raise NotImplementedError

    def finished(self):
        raise NotImplementedError

    def run(self):
        steps = self.steps()
        for number, (name, step) in enumerate(steps, 1):
            print(f"jig release: {self.command} {number}/{len(steps)}: {name}", flush=True)
            try:
                step()
            except (StepFailed, OSError) as error:
                if isinstance(error, OSError):
                    error = f"{error.filename or 'a file'}: {error.strerror or error}"
                print(f"jig release: {self.command} failed at {name}: {error}",
                      file=sys.stderr)
                return 1
        print(f"jig release: {self.finished()}", flush=True)
        return 0

    def say(self, text):
        print(f"jig release:   {text}", flush=True)

    def release_url(self, slug):
        return f"{self.api}/repos/{slug}/releases/tags/{urllib.parse.quote(self.tag)}"

    def read_back(self):
        """Compare the release, read with no login, with the staged files by name and hash."""
        release = http_json(self.release_url(origin_slug(self.product)))
        published = asset_names(release)
        if set(published) != set(self.staged):
            raise StepFailed(f"the release {self.tag} holds {sorted(published)}, "
                             f"the staging directory {sorted(self.staged)}")
        for name, url in sorted(published.items()):
            if hashlib.sha256(http(url)).hexdigest() != self.staged[name]:
                raise StepFailed(f"{name}, read from {url} with no login, differs from "
                                 f"the staged file")
        self.say(f"{len(published)} files read back with no login match the staged files")


class Publish(Published):
    command = "publish"

    def __init__(self, project, dry_run):
        super().__init__(project)
        self.dry_run = dry_run
        self.dev_commit = None
        self.notes = None

    def steps(self):
        return (("the staged release", self.staged_release),
                ("SHA256SUMS of the staged files", self.check_sums),
                ("the release commit", self.release_commit),
                ("the merge to master can fast-forward", self.merge_possible),
                ("the tag in the product", lambda: self.make_tag(self.product, "the product",
                                                                 self.commit, False)),
                ("the tag in -dev", lambda: self.make_tag(self.dev, "-dev", self.dev_commit,
                                                          True)),
                ("the GitHub release", self.github_release),
                ("the readback with no login", self.readback),
                ("the merge to master in the product",
                 lambda: self.merge(self.product, "the product", self.commit)),
                ("the merge to master in -dev",
                 lambda: self.merge(self.dev, "-dev", self.dev_commit)))

    def finished(self):
        if self.dry_run:
            return f"{self.project} {self.version} passes the checks; dry run, nothing changed"
        return f"{self.project} {self.version} is published: {self.tag} at {self.commit}"

    def staged_release(self):
        if not LINE_FORM.fullmatch(self.line):
            raise StepFailed(f"the line {self.line} is not of the form <X>.<Y>")
        if not (self.product / ".git").exists():
            raise StepFailed(f"no product clone at {self.product}")
        git_out(self.product, "fetch", "-q", "--tags", "origin")
        git_out(self.dev, "fetch", "-q", "--tags", "origin")
        self.commit = git_out(self.product, "rev-parse", "--verify",
                              f"refs/remotes/origin/{self.line}^{{commit}}")
        self.version = release_version(self.product, self.line, self.commit)
        self.staging = self.releases / self.version
        if not self.staging.is_dir():
            raise StepFailed(f"no staged release of {self.version} in {self.staging}; "
                             f"jig release {self.project} prepare stages it")
        self.say(f"version {self.version}, files in {self.staging}")

    def check_sums(self):
        self.staged = read_staged(self.staging)

    def release_commit(self):
        problem = release_commit_problem(self.product, self.commit, self.version)
        if problem:
            raise StepFailed(f"the head of origin/{self.line} of the product: {problem}")
        if not git(self.product, "config", "--get", "remote.origin.pushurl").stdout.strip():
            raise StepFailed(f"remote.origin.pushurl of {self.product} is not set; "
                             f"tools/push-on-token.sh sets it")
        self.dev_commit = git_out(self.dev, "rev-parse", "--verify",
                                  f"refs/remotes/origin/{self.line}^{{commit}}")
        self.notes = top_entry(self.product, self.commit)
        self.say(f"release commit {self.commit}, -dev commit {self.dev_commit}")

    def merge_possible(self):
        for clone, where, commit in ((self.product, "the product", self.commit),
                                     (self.dev, "-dev", self.dev_commit)):
            master = git(clone, "rev-parse", "-q", "--verify",
                         "refs/remotes/origin/master^{commit}").stdout.strip()
            if not master:
                raise StepFailed(f"the origin of {where} has no master")
            if git(clone, "merge-base", "--is-ancestor", master, commit).returncode != 0:
                raise StepFailed(f"master of {where} at {master} is not an ancestor of "
                                 f"{commit}, so the line cannot fast-forward it; nothing "
                                 f"was changed")

    def make_tag(self, clone, where, commit, earlier_head_matches):
        def matches(target):
            if target == commit:
                return True
            # In -dev the line moves on with status and report commits, so a tag that an
            # earlier run made at an older head of the line is still this release's tag.
            return earlier_head_matches and git(
                clone, "merge-base", "--is-ancestor", target, commit).returncode == 0

        tag = self.tag
        tag_object, target = remote_tag(clone, tag)
        if tag_object:
            if target is None:
                raise StepFailed(f"the tag {tag} on the origin of {where} is not annotated")
            if not matches(target):
                raise StepFailed(f"the tag {tag} on the origin of {where} points at "
                                 f"{target}, not at {commit}")
            self.say(f"{tag} exists already on the origin of {where}, at {target}")
            return
        local = git(clone, "rev-parse", "-q", "--verify", f"refs/tags/{tag}").stdout.strip()
        if local:
            target = git_out(clone, "rev-parse", f"{local}^{{commit}}")
            if git_out(clone, "cat-file", "-t", local) != "tag" or not matches(target):
                raise StepFailed(f"the tag {tag} in the clone of {where} is not an "
                                 f"annotated tag at {commit}")
        if self.dry_run:
            self.say(f"would {'push' if local else 'make and push'} the annotated tag "
                     f"{tag} at {target if local else commit} to the origin of {where}")
            return
        if not local:
            git_out(clone, "tag", "-a", tag, "-m", f"Release {self.version}", commit)
        result = git(clone, "push", "-q", "origin", f"refs/tags/{tag}:refs/tags/{tag}")
        if result.returncode != 0:
            raise StepFailed(f"git push of {tag} to the origin of {where} failed: "
                             f"{last_line(result.stderr)}")
        self.say(f"{tag} pushed to the origin of {where}")

    def token(self):
        path = pathlib.Path(os.path.expanduser(f"~/.config/jig/{self.project}-token"))
        try:
            token = path.read_text(encoding="utf-8").strip()
        except OSError as error:
            raise StepFailed(f"cannot read the token file {path}: {error.strerror}") from None
        if not token:
            raise StepFailed(f"the token file {path} is empty")
        return token

    def github_release(self):
        slug = origin_slug(self.product)
        token = self.token()
        release = missing_is_none(lambda: http_json(self.release_url(slug), token=token))
        published = asset_names(release) if release else {}
        extra = sorted(set(published) - set(self.staged))
        if extra:
            raise StepFailed(f"the release {self.tag} holds files that are not staged: "
                             f"{', '.join(extra)}")
        for name, url in sorted(published.items()):
            if hashlib.sha256(http(url)).hexdigest() != self.staged[name]:
                raise StepFailed(f"the release {self.tag} holds {name} with another hash "
                                 f"than the staged file")
        missing = sorted(set(self.staged) - set(published))
        if published:
            self.say(f"{len(published)} files are on the release already with the staged hashes")
        if self.dry_run:
            if release is None:
                self.say(f"would make the release {self.tag} of {slug}")
            for name in missing:
                self.say(f"would upload {name}")
            return
        if release is None:
            body = json.dumps({"tag_name": self.tag, "name": self.version, "body": self.notes,
                               "draft": False, "prerelease": False}).encode()
            release = http_json(f"{self.api}/repos/{slug}/releases", token=token, data=body,
                                content_type="application/json", method="POST")
            self.say(f"made the release {self.tag} of {slug}")
        upload = re.sub(r"\{[^}]*\}$", "", str(release.get("upload_url") or ""))
        if missing and not upload:
            raise StepFailed(f"the release {self.tag} has no upload URL")
        for name in missing:
            data = (self.staging / name).read_bytes()
            http(f"{upload}?name={urllib.parse.quote(name)}", token=token, data=data,
                 content_type="application/octet-stream", method="POST")
            self.say(f"uploaded {name}")

    def readback(self):
        if self.dry_run:
            self.say(f"would read the release {self.tag} and its files back with no login")
            return
        self.read_back()

    def merge(self, clone, where, commit):
        git_out(clone, "fetch", "-q", "origin")
        master = git_out(clone, "rev-parse", "--verify", "refs/remotes/origin/master^{commit}")
        if master != commit:
            if git(clone, "merge-base", "--is-ancestor", master, commit).returncode != 0:
                raise StepFailed(f"master of {where} at {master} is not an ancestor of "
                                 f"{commit}; publish does not merge it")
            if self.dry_run:
                self.say(f"would push {commit} to master of {where}, a fast-forward, "
                         f"and check that the trees are equal")
                return
            # No + on the refspec: the origin takes the push only as a fast-forward.
            result = git(clone, "push", "-q", "origin", f"{commit}:refs/heads/master")
            if result.returncode != 0:
                raise StepFailed(f"git push to master of {where} failed: "
                                 f"{last_line(result.stderr)}")
            git_out(clone, "fetch", "-q", "origin")
        else:
            self.say(f"master of {where} is at {commit} already")
        merged = git_out(clone, "rev-parse", "refs/remotes/origin/master^{tree}")
        tested = git_out(clone, "rev-parse", f"{commit}^{{tree}}")
        if merged != tested:
            raise StepFailed(f"the merge check: the tree of master of {where} after the "
                             f"fetch is {merged}, the tree of {commit} is {tested}")
        self.say(f"master of {where} has the tree of {commit}")


class Verify(Published):
    command = "verify"

    def __init__(self, project, version):
        super().__init__(project)
        self.version = version
        self.slug = None

    def steps(self):
        return (("the published files", self.published_files),
                ("the tag", self.check_tag),
                ("the repo is public", self.public),
                ("the badge", self.badge))

    def finished(self):
        return f"{self.project} {self.version} is verified: {self.tag} at {self.commit}"

    def published_files(self):
        if not (self.product / ".git").exists():
            raise StepFailed(f"no product clone at {self.product}")
        self.slug = origin_slug(self.product)
        self.staging = self.releases / self.version
        if not self.staging.is_dir():
            raise StepFailed(f"no staged release of {self.version} in {self.staging}")
        self.staged = read_staged(self.staging)
        self.read_back()

    def check_tag(self):
        _, target = remote_tag(self.product, self.tag)
        if target is None:
            raise StepFailed(f"the origin of the product has no annotated tag {self.tag}")
        # The release commit is on a branch of origin, so a fetch of the branches brings
        # it; a fetch of the tags could clash with a local tag and prove nothing more.
        git_out(self.product, "fetch", "-q", "origin")
        if git(self.product, "cat-file", "-e", f"{target}^{{commit}}").returncode != 0:
            raise StepFailed(f"{self.tag} points at {target}, which no branch of origin holds")
        problem = release_commit_problem(self.product, target, self.version)
        if problem:
            raise StepFailed(f"{self.tag} does not point at the release commit: {problem}")
        self.commit = target

    def public(self):
        url = f"{self.api}/repos/{self.slug}"
        try:
            repo = http_json(url)
        except StepFailed as error:
            raise StepFailed(f"the repo {self.slug} cannot be read with no login, so it "
                             f"is not public: {error}") from None
        if repo.get("private") is not False:
            raise StepFailed(f"the repo {self.slug} is not public")

    def badge(self):
        url = f"{self.web}/{self.slug}/actions/workflows/ci.yml/badge.svg?branch=master"
        text = http(url).decode("utf-8", errors="replace")
        if "passing" not in text:
            raise StepFailed(f"the badge {url} does not read passing")


def parse(argv):
    """Return (project, command, options), or None for a usage error."""
    if len(argv) < 2 or not jig_units.PROJECT.fullmatch(argv[0]):
        return None
    project, command, words = argv[0], argv[1], argv[2:]
    if command == "publish":
        if words not in ([], ["--dry-run"]):
            return None
        return project, command, {"dry_run": bool(words)}
    if command == "verify":
        if len(words) != 1 or not VERSION_FORM.fullmatch(words[0]):
            return None
        return project, command, {"version": words[0]}
    if command != "prepare":
        return None
    options = {}
    while words:
        if words[0] not in ("--entry", "--trailer") or len(words) < 2 \
                or words[0] in options:
            return None
        options[words[0]] = words[1]
        words = words[2:]
    # The release commit goes to a public line, where a missing trailer can never be
    # added, so the trailer is not optional.
    trailer = options.get("--trailer")
    if "--entry" not in options or trailer is None or not trailer.strip() \
            or "\n" in trailer:
        return None
    return project, command, {"entry_file": options["--entry"], "trailer": trailer}


def main(argv):
    parsed = parse(argv)
    if parsed is None:
        print(USAGE, file=sys.stderr)
        return 2
    project, command, options = parsed
    kind = {"prepare": Prepare, "publish": Publish, "verify": Verify}[command]
    try:
        return kind(project, **options).run()
    except jig_units.Refused as error:
        print(f"jig release: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
