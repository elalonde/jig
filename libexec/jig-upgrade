#!/usr/bin/env python3
"""Install a released jig version, and pin a project to it.

usage: jig upgrade <version>
       jig upgrade <project> <version>

Run as the orchestrator account, which owns the install root.

jig upgrade <version> downloads the files of the GitHub release v<version> with no
login, checks every one of them against the release's SHA256SUMS, and installs the
package jig-<version>.tar.gz under <root>/<version>/ with tools/install.sh of the
tree this command runs from. install.sh points <root>/current to the newest
installed version. A version installed already with the same content is no change
and exits 0; one with other content is refused, because an installed version never
changes under a project pinned to it. A file whose hash does not match stops the
command before anything is installed.

jig upgrade <project> <version> installs <version> first when it is missing. Then
it sets JIG_VERSION=<version> in ~/.config/jig/<project>.conf of every role account
that the orchestrator's conf file of the project names (ORCH_ACCOUNT, SPEC_ACCOUNT,
IMPL_ACCOUNT and REV_ACCOUNT): the orchestrator's own conf file here, every other
account's through ssh, with the command in JIG_SSH, as jig new reaches them. It
first checks the lock <lock dir>/<project>-<account> of each account and that each
conf file can be written, and changes nothing while a lock exists or a conf file is
missing: a project in the middle of a unit never has its version moved. A conf file
with no JIG_VERSION line gets one.

The GitHub repository is the origin of the jig clone ~/ws/src/jig-dev/jig, unless
JIG_UPGRADE_REPO=<owner>/<repo> names it. The other places come from the
environment too: JIG_ROOT (default /opt/jig), JIG_GITHUB_API (default
https://api.github.com), JIG_SSH (default ssh -o BatchMode=yes) and JIG_LOCK_DIR
(default /run/jig/lock).

A new version can be installed before any installed version has this command, by
running this file by its path from a clone:
  ~/ws/src/jig-dev/jig/libexec/jig-upgrade <version>

Steps go to stdout; a refusal goes to stderr as one line. Exits 0 on success, 1 on
a refusal or a failed download or install, 2 on a usage error.
"""

import hashlib
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

# The install root is shared by every project, so this command never leaves byte
# code in a tree it runs from.
sys.dont_write_bytecode = True

ROOT = pathlib.Path(__file__).resolve().parent.parent
INSTALL = ROOT / "tools" / "install.sh"
GITHUB_API = "https://api.github.com"
INSTALL_ROOT = "/opt/jig"
LOCK_DIR = "/run/jig/lock"
SUMS = "SHA256SUMS"
ROLE_KEYS = ("ORCH_ACCOUNT", "SPEC_ACCOUNT", "IMPL_ACCOUNT", "REV_ACCOUNT")

VERSION = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
# The project names that jig new accepts.
PROJECT = re.compile(r"[a-z][a-z0-9]*(?:-[a-z0-9]+)*")
ACCOUNT = re.compile(r"[a-z_][a-z0-9_-]*")
SLUG = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
# The owner and repository at the end of an ssh or https origin URL.
ORIGIN_SLUG = re.compile(r"[:/]([^/:]+/[^/:]+?)(?:\.git)?/?$")
# A release file name: one path part, with no blank at its start.
FILE_NAME = re.compile(r"[^/\s][^/]*")
SUMS_LINE = re.compile(r"([0-9a-f]{64})  ([^/\s][^/]*)")

HTTP_TIMEOUT_SECONDS = 60
SSH_TIMEOUT_SECONDS = 60
# A release file larger than this is not a jig release, and reading it would only
# fill the disk.
MAX_FILE_BYTES = 200 * 1024 * 1024
CHUNK_BYTES = 1 << 16

# Runs in each role account, the orchestrator's included, with python3 -I and this
# text on stdin, so that no account needs a file of jig's for it. "check" exits 0
# only when the account's conf file of the project exists and can be replaced;
# "write" sets its JIG_VERSION line. The file is replaced by a rename, so that the
# dispatcher, which reads it at any time, never sees half of it.
ACCOUNT_SCRIPT = r'''
import os, pathlib, re, sys, tempfile

mode, project, version = sys.argv[1:4]
path = (pathlib.Path.home() / ".config" / "jig" / f"{project}.conf").resolve()
try:
    text = path.read_text(encoding="utf-8")
except OSError as error:
    sys.exit(f"cannot read {path}: {error.strerror}")
if not os.access(path, os.W_OK) or not os.access(path.parent, os.W_OK | os.X_OK):
    sys.exit(f"cannot write {path}")
if mode == "check":
    sys.exit(0)

# The dispatcher reads the last line that starts with JIG_VERSION=; the first such
# line takes the new value and the others go, so that one value remains.
wanted = f"JIG_VERSION={version}\n"
lines = []
placed = False
for line in text.splitlines(keepends=True):
    if re.match(r"\s*JIG_VERSION\s*=", line):
        if not placed:
            lines.append(wanted)
            placed = True
        continue
    lines.append(line)
if not placed:
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    lines.append(wanted)
updated = "".join(lines)
if updated == text:
    print(f"{path}: JIG_VERSION={version} already")
    sys.exit(0)
descriptor, scratch = tempfile.mkstemp(prefix=f".{project}.conf.", dir=path.parent)
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(updated)
    os.chmod(scratch, path.stat().st_mode & 0o7777)
    os.replace(scratch, path)
except BaseException:
    os.unlink(scratch)
    raise
print(f"{path}: JIG_VERSION={version}")
'''


class Refusal(Exception):
    pass


def say(text):
    print(text, flush=True)


def install_root():
    return pathlib.Path(os.environ.get("JIG_ROOT") or INSTALL_ROOT)


def api_base():
    return (os.environ.get("JIG_GITHUB_API") or GITHUB_API).rstrip("/")


def repository():
    """Return owner/repo of jig on GitHub."""
    named = os.environ.get("JIG_UPGRADE_REPO")
    if named:
        if not SLUG.fullmatch(named):
            raise Refusal(f"JIG_UPGRADE_REPO={named!r} is not <owner>/<repo>")
        return named
    clone = pathlib.Path.home() / "ws" / "src" / "jig-dev" / "jig"
    try:
        origin = subprocess.run(["git", "-C", str(clone), "remote", "get-url", "origin"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, OSError):
        raise Refusal(f"cannot read the origin of {clone}; set JIG_UPGRADE_REPO "
                      f"to <owner>/<repo>") from None
    match = ORIGIN_SLUG.search(origin)
    if not match or not SLUG.fullmatch(match.group(1)):
        raise Refusal(f"cannot read <owner>/<repo> from the origin of {clone}: {origin}")
    return match.group(1)


def open_url(url, accept):
    """Open a URL of the API with no login; the repository is public."""
    request = urllib.request.Request(url, headers={
        "Accept": accept,
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "jig-upgrade",
    })
    try:
        return urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS)
    except urllib.error.HTTPError as error:
        raise Refusal(f"{url}: HTTP {error.code}") from None
    except (urllib.error.URLError, OSError) as error:
        raise Refusal(f"{url}: {error}") from None


def release_files(slug, version):
    """Return {name: download URL} of the release v<version>.

    Each file is fetched from the API's asset endpoint, which answers the raw bytes
    to Accept: application/octet-stream, so that every request goes to the API base.
    """
    api = api_base()
    url = f"{api}/repos/{slug}/releases/tags/v{version}"
    try:
        with open_url(url, "application/vnd.github+json") as response:
            release = json.load(response)
    except ValueError:
        raise Refusal(f"{url}: the answer is not JSON") from None
    except Refusal as error:
        if str(error).endswith("HTTP 404"):
            raise Refusal(f"{slug} has no release v{version}") from None
        raise
    files = {}
    try:
        for asset in release.get("assets") or []:
            name, number = asset["name"], asset["id"]
            if not isinstance(number, int) or not FILE_NAME.fullmatch(name):
                raise TypeError
            files[name] = f"{api}/repos/{slug}/releases/assets/{number}"
    except (KeyError, TypeError, AttributeError):
        raise Refusal(f"{url}: a release file has no plain name or id") from None
    return files


def download(url, target):
    """Write the file at url to target and return its sha256."""
    digest = hashlib.sha256()
    size = 0
    with open_url(url, "application/octet-stream") as response, open(target, "wb") as stream:
        try:
            for chunk in iter(lambda: response.read(CHUNK_BYTES), b""):
                size += len(chunk)
                if size > MAX_FILE_BYTES:
                    raise Refusal(f"{target.name} is larger than {MAX_FILE_BYTES} bytes")
                digest.update(chunk)
                stream.write(chunk)
        except OSError as error:
            raise Refusal(f"{url}: {error}") from None
    return digest.hexdigest()


def read_sums(path):
    listed = {}
    for text in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = SUMS_LINE.fullmatch(text)
        if not match or match.group(2) in listed or match.group(2) == SUMS:
            raise Refusal(f"{SUMS} has a line that is not '<sha256>  <file name>' of one "
                          f"other file: {text}")
        listed[match.group(2)] = match.group(1)
    return listed


def install(version):
    """Download, check and install the release v<version>."""
    slug = repository()
    say(f"release v{version} of {slug}")
    files = release_files(slug, version)
    package = f"jig-{version}.tar.gz"
    if SUMS not in files:
        raise Refusal(f"release v{version} has no {SUMS}")
    with tempfile.TemporaryDirectory(prefix="jig-upgrade.") as scratch:
        folder = pathlib.Path(scratch)
        download(files[SUMS], folder / SUMS)
        listed = read_sums(folder / SUMS)
        if package not in listed:
            raise Refusal(f"{SUMS} of v{version} does not list {package}")
        published = set(files) - {SUMS}
        if published != set(listed):
            extra = sorted(published - set(listed))
            missing = sorted(set(listed) - published)
            raise Refusal(f"{SUMS} does not match the release files: not listed "
                          f"{extra or 'none'}, missing {missing or 'none'}")
        for name in sorted(listed):
            if download(files[name], folder / name) != listed[name]:
                raise Refusal(f"{name} does not match its hash in {SUMS}; nothing installed")
            say(f"checked {name}")
        result = subprocess.run([str(INSTALL), str(folder / package), str(install_root()),
                                 version], capture_output=True, text=True, check=False)
    for line in result.stdout.splitlines():
        say(line)
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise Refusal(f"{INSTALL} failed: {detail}")


def read_conf(path):
    """Read a conf file as data: running it would run whatever it holds."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise Refusal(f"cannot read {path}: {error.strerror}") from None
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip().strip("\"'")
    return values


def role_accounts(project):
    """Return the orchestrator account and every other role account, each once."""
    path = pathlib.Path.home() / ".config" / "jig" / f"{project}.conf"
    conf = read_conf(path)
    orchestrator = conf.get("ORCH_ACCOUNT", "")
    if not orchestrator:
        raise Refusal(f"{path} names no ORCH_ACCOUNT")
    named = []
    for key in ROLE_KEYS:
        named.extend(conf.get(key, "").split())
    accounts = list(dict.fromkeys(named))
    for account in accounts:
        if not ACCOUNT.fullmatch(account):
            raise Refusal(f"{path}: {account!r} is not an account name")
    return orchestrator, accounts


def lock_path(project, account):
    return pathlib.Path(os.environ.get("JIG_LOCK_DIR") or LOCK_DIR) / f"{project}-{account}"


def check_locks(project, accounts):
    for account in accounts:
        lock = lock_path(project, account)
        if lock.exists():
            raise Refusal(f"{lock} exists: a unit of {project} runs in {account}, so its "
                          f"version stays; no conf file changed")


def account_command(account, orchestrator, words):
    """The command that runs the account script in an account; local for the orchestrator."""
    if account == orchestrator:
        return [sys.executable, "-I", "-", *words]
    ssh = shlex.split(os.environ.get("JIG_SSH", "ssh -o BatchMode=yes"))
    return [*ssh, f"{account}@localhost", shlex.join(["python3", "-I", "-", *words])]


def in_account(account, orchestrator, words):
    """Run the account script; return its output, or raise with its reason."""
    try:
        result = subprocess.run(account_command(account, orchestrator, words),
                                input=ACCOUNT_SCRIPT, capture_output=True, text=True,
                                timeout=SSH_TIMEOUT_SECONDS, check=False)
    except subprocess.TimeoutExpired:
        raise Refusal(f"account {account}: no answer in {SSH_TIMEOUT_SECONDS} s") from None
    except OSError as error:
        raise Refusal(f"account {account}: {error.strerror}") from None
    if result.returncode != 0:
        detail = result.stderr.strip().splitlines()
        raise Refusal(f"account {account}: {detail[-1] if detail else f'exit {result.returncode}'}")
    return result.stdout


def pin(project, version):
    orchestrator, accounts = role_accounts(project)
    # Every check comes before the install and before any write, so that a refusal
    # leaves every conf file as it was.
    check_locks(project, accounts)
    for account in accounts:
        in_account(account, orchestrator, ["check", project, version])
    say(f"conf files of {project}: {', '.join(accounts)}")

    target = install_root() / version
    if target.is_dir():
        say(f"{version} is installed under {install_root()}")
    else:
        install(version)
    # The dispatcher refuses a pin to a version that is not installed.
    if not target.is_dir():
        raise Refusal(f"{target} is not installed; no conf file changed")
    # A unit may have started during the download.
    check_locks(project, accounts)

    written = []
    for account in accounts:
        try:
            output = in_account(account, orchestrator, ["write", project, version])
        except Refusal as error:
            done = ", ".join(written) or "none"
            raise Refusal(f"{error}; pinned already: {done}; run this command again") from None
        for line in output.splitlines():
            say(f"{account}: {line}")
        written.append(account)
    say(f"{project} is pinned to {version} in {len(written)} accounts")


def main(argv):
    if argv in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    if len(argv) == 1 and VERSION.fullmatch(argv[0]):
        project, version = None, argv[0]
    elif len(argv) == 2 and PROJECT.fullmatch(argv[0]) and VERSION.fullmatch(argv[1]):
        project, version = argv
    else:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        if project is None:
            install(version)
        else:
            pin(project, version)
    except Refusal as error:
        print(f"jig upgrade: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
